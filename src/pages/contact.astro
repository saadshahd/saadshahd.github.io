---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Saad Shahd">
  <div class="max-w-4xl mx-auto px-6 py-20">
    <h1 class="text-5xl font-bold mb-12">Get in Touch</h1>
    <p class="text-xl text-gray-600 mb-16 leading-relaxed">
      Looking to collaborate on realtime systems, discuss functional thinking, or explore how to eliminate complexity before it exists? Let's talk.
    </p>

    <div class="space-y-8">
      <div>
        <h2 class="text-xl font-semibold mb-2 text-gray-800">Email</h2>
        <a href="mailto:dev.saad.shahd@gmail.com" class="text-blue-600 hover:underline text-lg">
          dev.saad.shahd@gmail.com
        </a>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2 text-gray-800">LinkedIn</h2>
        <a href="https://linkedin.com/in/saadshahd" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline text-lg">
          linkedin.com/in/saadshahd
        </a>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2 text-gray-800">GitHub</h2>
        <a href="https://github.com/saadshahd" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline text-lg">
          github.com/saadshahd
        </a>
      </div>
    </div>
  </div>
</Layout>
