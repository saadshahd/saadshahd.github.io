---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/typography/Heading.astro';
import Body from '../components/typography/Body.astro';
import Link from '../components/Link.astro';
---

<Layout title="Contact - Saad Shahd" disableAutoHideNav={true}>
  <div class="max-w-4xl mx-auto px-4 md:px-6 py-12">
    <Heading level={1} as="h1" class="mb-16"><span>Get in Touch</span></Heading>
    <Body size="lg" as="p" class="text-text-lighter mb-16 leading-normal">
      Curious about realtime systems, functional thinking, or architectural patterns that eliminate complexity before it exists? I'd love to explore how these patterns apply to your context.
    </Body>

    <div class="space-y-8">
      <div>
        <Heading level={2} as="h2" class="mb-2 text-navy"><span>Email</span></Heading>
        <Link href="mailto:dev.saad.shahd@gmail.com" variant="inline" class="text-lg">
          dev.saad.shahd@gmail.com
        </Link>
      </div>

      <div>
        <Heading level={2} as="h2" class="mb-2 text-navy"><span>LinkedIn</span></Heading>
        <Link href="https://linkedin.com/in/saadshahd" variant="external" external class="text-lg">
          linkedin.com/in/saadshahd
        </Link>
      </div>

      <div>
        <Heading level={2} as="h2" class="mb-2 text-navy"><span>GitHub</span></Heading>
        <Link href="https://github.com/saadshahd" variant="external" external class="text-lg">
          github.com/saadshahd
        </Link>
      </div>
    </div>
  </div>
</Layout>
