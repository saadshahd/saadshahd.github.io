---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Saad Shahd">
  <div class="max-w-4xl mx-auto px-6 py-20">
    <h1 class="text-5xl font-bold mb-12">Get in Touch</h1>
    <p class="text-xl text-gray-600 mb-16">
      I'm always interested in hearing about new opportunities and collaborations.
    </p>

    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-semibold mb-2">Email</h2>
        <a href="mailto:your.email@example.com" class="text-blue-600 hover:underline">
          your.email@example.com
        </a>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">LinkedIn</h2>
        <a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
          linkedin.com/in/your-profile
        </a>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-2">GitHub</h2>
        <a href="https://github.com/your-username" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
          github.com/your-username
        </a>
      </div>
    </div>
  </div>
</Layout>
