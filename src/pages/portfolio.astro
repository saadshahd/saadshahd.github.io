---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio - Saad Shahd">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <h1 class="text-5xl font-bold mb-12">Portfolio</h1>
    <p class="text-xl text-gray-600 mb-16">Selected case studies showcasing technical depth and impact</p>

    <div class="grid gap-12">
      <div class="border border-gray-200 p-8 hover:border-gray-400 transition-colors">
        <h2 class="text-2xl font-semibold mb-4">StatsBomb Real-Time Data Collection</h2>
        <p class="text-gray-600 mb-4">
          Building a distributed system for real-time sports analytics processing
        </p>
        <span class="inline-block text-sm text-gray-500">Coming soon...</span>
      </div>
    </div>
  </div>
</Layout>
