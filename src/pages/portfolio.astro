---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import BadgeList from '../components/BadgeList.astro';
import Heading from '../components/typography/Heading.astro';
import Body from '../components/typography/Body.astro';
---

<Layout title="Portfolio - Saad Shahd">
  <Container width="default">
    <Heading level={1} as="h1" class="mb-2">Portfolio</Heading>
    <Body size="lg" as="p" class="text-text-lighter mb-8">Selected case studies showcasing technical depth and impact</Body>

    <div class="grid gap-8 md:gap-16">
      <!-- Statsbomb Case Study -->
      <Card variant="case-study" href="/portfolio/statsbomb">
        <div class="p-8">
          <Heading level={3} as="h2" class="mb-4">Statsbomb Collection</Heading>
          <Body size="base" as="p" class="text-text-lighter mb-6 leading-relaxed">
            How do you scale real-time sports data collection without sacrificing correctness?
            Week one partnership: Ali dictated rules, I typed configuration, collectors thanked us. We built prevention into collection tools, gave product managers ownership through configuration, scaled to 5000+ collectors across sports. Architecture emerged over three years. Team building took longer—by the time ownership became distributed, I'd left Egypt. Lesson: sustainable systems need teams, not just separation.
          </Body>
          <BadgeList
            badges={[
              { label: "Real-Time Data Collection", variant: "category" },
              { label: "State Machines", variant: "status" },
              { label: "Configuration-Driven", variant: "skill" }
            ]}
          />
        </div>
      </Card>

      <!-- Future Case Study Placeholder 1 -->
      <Card variant="case-study">
        <div class="p-8 opacity-50">
          <Heading level={3} as="h2" class="mb-4"><span>Wise Editorial Platform</span></Heading>
          <Body size="base" as="p" class="text-text-lighter mb-6 leading-relaxed">
            How do 20 teams collaborate on wise.com without friction or incorrectness?
            Building editorial infrastructure that handles global→local fintech complexity—regulations differ by market, offerings vary by country, cultural nuances matter.
            The challenge is architectural: coherence at scale while preserving developer experience. Puck and Payload became foundations for structured flexibility—schema-driven boundaries let teams compose freely without breaking each other.
            Still exploring what content collaboration looks like at 16M+ customer scale.
          </Body>
          <BadgeList
            badges={[
              { label: "Multi-Team Collaboration", variant: "category" },
              { label: "Content Governance", variant: "category" },
              { label: "Puck", variant: "status" },
              { label: "Payload", variant: "status" },
              { label: "Structured Flexibility", variant: "skill" }
            ]}
            class="mb-4"
          />
          <Body size="sm" as="div" class="text-text-lighter">
            Coming soon...
          </Body>
        </div>
      </Card>
    </div>
  </Container>
</Layout>
