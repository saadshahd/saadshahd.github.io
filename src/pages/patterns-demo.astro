---
/**
 * Pattern Demo - Test page for Egyptian geometric patterns
 * Shows PyramidGrid + WaterFlow in action
 */

import PyramidGrid from '../components/patterns/PyramidGrid.astro';
import WaterFlow from '../components/patterns/WaterFlow.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Egyptian Patterns Demo</title>
</head>
<body>
  <!-- Background Patterns -->
  <PyramidGrid />
  <WaterFlow variant="horizontal" />

  <!-- Content -->
  <div class="content">
    <section class="hero">
      <h1><span>Egyptian Pattern System</span></h1>
      <p class="subtitle">
        Geometric pyramids and Nile-inspired water flows<br>
        Built with your SVG paths + Motion One
      </p>

      <div class="scroll-indicator">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </section>

    <section class="section">
      <div class="pattern-info">
        <h2><span>🔺 Your Pyramid Path</span></h2>
        <p>Original: <code>M0-45-45 0H45L0-45</code></p>
        <p>Refined: <code>M 0 -45 L -45 0 L 45 0 Z</code></p>

        <pre><code>&lt;svg viewBox="-50 -50 100 100"&gt;
  &lt;path d="M 0 -45 L -45 0 L 45 0 Z" fill="#F4C430" /&gt;
&lt;/svg&gt;</code></pre>

        <p><strong>What it does:</strong></p>
        <ul>
          <li>3 large pyramids (800px, 600px, 700px)</li>
          <li>Golden ratio placement (20%, 65%, 15%)</li>
          <li>Staggered fade-in animation (0s, 0.2s, 0.4s delay)</li>
          <li>One inverted (180° rotation)</li>
          <li>Respects <code>prefers-reduced-motion</code></li>
        </ul>
      </div>

      <div class="pattern-info">
        <h2><span>🌊 Your Wave Path</span></h2>
        <p>Original: <code>M180 0C120 45 45-45 0 0</code></p>
        <p>Refined: <code>M 180 0 C 120 45, 45 -45, 0 0</code></p>

        <pre><code>&lt;svg viewBox="0 -50 720 100"&gt;
  &lt;path
    d="M 0 0 C 60 -45, 120 45, 180 0 C 240 -45, 300 45, 360 0"
    stroke="#0EA5E9"
    stroke-width="2"
    fill="none"
  /&gt;
&lt;/svg&gt;</code></pre>

        <p><strong>What it does:</strong></p>
        <ul>
          <li>Repeating S-curve wave pattern (4 waves)</li>
          <li>Stroke-dashoffset animation (flowing effect)</li>
          <li>Opacity increases as you scroll down</li>
          <li>Echo wave layer for depth (cyan accent)</li>
          <li>Static on mobile (no animation)</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <h2><span>✨ Animation Details</span></h2>

      <div class="pattern-info">
        <h3><span>Motion One Integration</span></h3>
        <p>Both patterns use Motion One (5KB) for animations:</p>

        <pre><code>// Pyramid entrance (PyramidGrid.astro)
animate(pyramidWrappers, &#123;
  opacity: [0, 1],
  scale: [0.8, 1],
  rotate: ['15deg', '0deg']
&#125;, &#123;
  duration: 1.5,
  delay: stagger(0.2),
  easing: [0.65, 0, 0.35, 1]
&#125;);

// Wave flow (WaterFlow.astro)
const pathLength = path.getTotalLength();
animate(path, &#123;
  strokeDashoffset: [pathLength, 0]
&#125;, &#123;
  duration: 3,
  repeat: Infinity,
  easing: "linear"
&#125;);</code></pre>
      </div>

      <div class="controls">
        <h3><span>🎮 Test Controls</span></h3>

        <div class="control-group">
          <label>Scroll down to see:</label>
          <ul>
            <li>Water flow opacity increases</li>
            <li>Patterns stay fixed in background</li>
            <li>Content scrolls over patterns</li>
          </ul>
        </div>

        <div class="control-group">
          <label>Try these tests:</label>
          <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            Scroll to Top
          </button>
          <button onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})">
            Scroll to Bottom
          </button>
        </div>

        <div class="control-group">
          <label>Accessibility:</label>
          <p>
            ✅ Patterns respect <code>prefers-reduced-motion</code><br>
            ✅ Hidden from screen readers (<code>aria-hidden="true"</code>)<br>
            ✅ No pointer events (doesn't block clicks)<br>
            ✅ Mobile-optimized (lighter, smaller, static)
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2><span>📝 Next Steps</span></h2>

      <div class="pattern-info">
        <h3><span>Integration into Homepage</span></h3>
        <pre><code>---
// src/pages/index.astro
import PyramidGrid from '@/components/patterns/PyramidGrid.astro';
import WaterFlow from '@/components/patterns/WaterFlow.astro';
---

&lt;PyramidGrid /&gt;
&lt;WaterFlow variant="horizontal" /&gt;

&lt;main&gt;
  &lt;!-- Your content here --&gt;
&lt;/main&gt;</code></pre>

        <h3><span>Create More Pattern Variations</span></h3>
        <p>Try creating these next:</p>
        <ul>
          <li><strong>Inverted Pyramid:</strong> <code>M 0 45 L -45 0 L 45 0 Z</code> (point down)</li>
          <li><strong>Diamond:</strong> <code>M 0 -45 L 45 0 L 0 45 L -45 0 Z</code></li>
          <li><strong>Smoother Wave:</strong> Add more control points to your Bézier curve</li>
          <li><strong>Vertical Flow:</strong> Use <code>&lt;WaterFlow variant="vertical" /&gt;</code></li>
        </ul>

        <h3><span>Advanced Animations</span></h3>
        <p>From the Animation Registry, you can now add:</p>
        <ul>
          <li>Scroll-triggered reveals (case study sections)</li>
          <li>Word-by-word typography animations</li>
          <li>SVG path morphing (pyramid → wave transitions)</li>
          <li>Context-aware logo (morphs on scroll)</li>
        </ul>
      </div>
    </section>

    <section class="section" style="min-height: 50vh;">
      <h2><span>🎨 Pattern Philosophy</span></h2>
      <p style="font-size: 1.25rem; line-height: 1.8; max-width: 800px;">
        These patterns embody Egyptian heritage as a subtle backdrop. Large-scale geometry (800px pyramids) with breathing room. 2-3 elements maximum. Opacity 0.08-0.12 ensures patterns never distract from content. Golden ratio placement creates natural visual rhythm. Desktop-optimized animations with mobile-friendly static fallbacks.
      </p>
    </section>
  </div>
</body>
</html>

<style>
  :root {
    --color-primary: #F4C430;
    --color-secondary: #0EA5E9;
    --color-accent: #06B6D4;
    --color-background: #F5F1E8;
    --color-text: #1E293B;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--color-background);
    color: var(--color-text);
    min-height: 200vh;
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .subtitle {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: var(--color-text);
    opacity: 0.7;
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .pattern-info {
    background: white;
    border-radius: 1rem;
    padding: 2rem;
    margin: 2rem 0;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .pattern-info h2 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .pattern-info h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .pattern-info code {
    background: var(--color-background);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .pattern-info pre {
    background: var(--color-background);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .pattern-info pre code {
    background: none;
    padding: 0;
  }

  .pattern-info ul {
    margin-left: 1.5rem;
    margin-top: 0.5rem;
  }

  .pattern-info li {
    margin: 0.5rem 0;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
    opacity: 0.5;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
  }

  .section {
    padding: 4rem 0;
  }

  .section h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--color-primary);
  }

  .controls {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    margin: 2rem 0;
  }

  .control-group {
    margin: 1rem 0;
  }

  .control-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .control-group ul {
    margin-left: 1.5rem;
    margin-top: 0.5rem;
  }

  button {
    background: var(--color-primary);
    color: var(--color-text);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }

  button:hover {
    transform: scale(1.05);
  }

  button:active {
    transform: scale(0.95);
  }
</style>
