---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Saad Shahd - Principal Engineer">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <section class="min-h-[80vh] flex flex-col justify-center">
      <h1 class="text-6xl md:text-7xl font-bold mb-6 leading-tight">
        Saad Shahd
      </h1>
      <p class="text-2xl md:text-3xl text-gray-600 mb-8 max-w-3xl">
        Principal Engineer specializing in real-time systems and functional architecture
      </p>
      <div class="flex gap-4">
        <a href="/portfolio" class="px-6 py-3 bg-black text-white hover:bg-gray-800 transition-colors">
          View Work
        </a>
        <a href="/contact" class="px-6 py-3 border border-black hover:bg-gray-50 transition-colors">
          Get in Touch
        </a>
      </div>
    </section>
  </div>
</Layout>
