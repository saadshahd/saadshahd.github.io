---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Saad Shahd - Principal Engineer">
  <div class="max-w-6xl mx-auto px-6">
    <section class="min-h-[calc(100vh-5rem)] flex flex-col justify-center">
      <h1 class="hero-name text-6xl md:text-7xl font-bold mb-6 leading-tight opacity-0">
        Saad Shahd
      </h1>
      <p class="hero-title text-2xl md:text-3xl text-gray-600 mb-6 max-w-3xl opacity-0">
        Principal Engineer specializing in real-time systems and functional architecture
      </p>
      <p class="hero-value text-lg md:text-xl text-gray-500 mb-12 max-w-2xl opacity-0">
        I build high-performance distributed systems that process millions of events per second
        while maintaining reliability and developer joy.
      </p>
      <div class="hero-ctas flex gap-4 opacity-0">
        <Button variant="primary" size="lg" href="/portfolio">
          View Work
        </Button>
        <Button variant="secondary" size="lg" href="/contact">
          Get in Touch
        </Button>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { animate, stagger } from 'motion';

  function animateHero() {
    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      // Animate hero elements with staggered timing
      // Motion One expects a selector string, not an array
      animate(
        '.hero-name, .hero-title, .hero-value, .hero-ctas',
        {
          opacity: [0, 1],
          y: [30, 0]
        },
        {
          duration: 0.8,
          easing: [0.16, 1, 0.3, 1], // easeOutExpo equivalent
          delay: stagger(0.15) // 150ms stagger between elements
        }
      );
    } else {
      // If reduced motion, just show everything immediately
      document.querySelectorAll('.hero-name, .hero-title, .hero-value, .hero-ctas').forEach(el => {
        el.style.opacity = '1';
      });
    }
  }

  // Run on initial load AND after every View Transition
  document.addEventListener('astro:page-load', animateHero);
</script>
