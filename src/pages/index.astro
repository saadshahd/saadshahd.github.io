---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Display from '../components/typography/Display.astro';
import Body from '../components/typography/Body.astro';
import Heading from '../components/typography/Heading.astro';
---

<Layout title="Saad Shahd - Software Engineer" disableAutoHideNav={true}>
  <!-- Centered content on top of patterns -->
  <Container width="default" spacing="hero" class="relative flex flex-col justify-center items-center" style="z-index: 1;">
    <div class="w-full flex flex-col items-center text-center">
      <Display level={1} as="h1" class="hero-name mb-2 leading-tight opacity-0 max-w-150 md:max-w-170">
        Saad Shahd
      </Display>
      <Heading level={3} class="hero-title leading-tight text-text mb-6 opacity-0 max-w-150 md:max-w-170 text-balance">
        What if systems couldn't break by design?
      </Heading>
      <Body size="lg" as="p" class="hero-value text-text-lighter mb-8 leading-relaxed opacity-0 max-w-150 md:max-w-150 lg:text-lg text-balance">
        Over a decade building products for the humans, one pattern keeps appearing: when systems can't break by design, reliability becomes structural. Still exploring what's possible when architecture serves people first—curious about your context?
      </Body>
      <div class="hero-ctas flex gap-4 justify-center opacity-0">
        <Button variant="primary" size="md" href="/portfolio" trackLocation="hero">
          <span class="inline sm:hidden">View Work</span>
          <span class="hidden sm:inline">Explore My Work</span>
        </Button>
        <Button variant="secondary" size="md" href="/contact" trackLocation="hero">
          <span class="inline sm:hidden">Let's Talk</span>
          <span class="hidden sm:inline">Start a Conversation</span>
        </Button>
      </div>
    </div>
  </Container>
</Layout>

<script>
  import { animate, stagger } from 'motion';
  import type { DOMKeyframesDefinition } from 'motion';

  function animateHero() {
    // Guard: Only run if hero elements exist (prevents errors on other pages)
    const heroElements = document.querySelectorAll('.hero-name, .hero-title, .hero-value, .hero-ctas');
    if (heroElements.length === 0) return;

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.innerWidth >= 1024;

    if (!prefersReducedMotion) {
      // Content: Animate hero elements with staggered timing
      // ✅ Type-safe Motion One usage: individual transform properties, not transform strings
      const keyframes: DOMKeyframesDefinition = {
        opacity: [0, 1],
        y: [30, 0] // Use 'y' property instead of transform: "translateY()"
      };

      animate('.hero-name, .hero-title, .hero-value, .hero-ctas', keyframes, {
        duration: 0.8,
        delay: stagger(0.15, { startDelay: isDesktop ? 0.6 : 0.3 }) // Desktop: wait for patterns, Mobile: smoother entry
      });
    } else {
      // If reduced motion, just show content immediately
      heroElements.forEach(el => {
        (el as HTMLElement).style.opacity = '1';
      });
    }
  }

  // Run on initial load AND after every View Transition
  document.addEventListener('astro:page-load', animateHero);
</script>
