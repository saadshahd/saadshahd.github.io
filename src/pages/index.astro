---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Saad Shahd - Principal Engineer">
  <!-- Centered content on top of patterns -->
  <div class="max-w-6xl mx-auto px-6 relative" style="z-index: 1;">
    <section class="min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center text-center">
      <h1 class="hero-name text-[3.5rem] md:text-[4.5rem] font-bold text-accent mb-6 leading-tight opacity-0 max-w-[42.5rem] text-balance">
        Saad Shahd
      </h1>
      <p class="hero-title text-[1.75rem] md:text-[2.25rem] text-neutral mb-6 opacity-0 max-w-[42.5rem] text-balance">
        Principal Engineer specializing in real-time systems and functional architecture
      </p>
      <p class="hero-value text-[1.25rem] md:text-[1.5rem] text-neutral-light mb-12 leading-relaxed opacity-0 max-w-[42.5rem] text-balance">
        I design systems where illegal states can't exist.
        When you separate behavior from state, reliability isn't a feature—it's inevitable.
        That's functional architecture in production.
      </p>
      <div class="hero-ctas flex gap-4 justify-center opacity-0">
        <Button variant="primary" size="lg" href="/portfolio">
          View Work
        </Button>
        <Button variant="secondary" size="lg" href="/contact">
          Get in Touch
        </Button>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { animate, stagger } from 'motion';

  function animateHero() {
    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.innerWidth >= 1024;

    if (!prefersReducedMotion) {
      // Content: Animate hero elements with staggered timing
      animate(
        '.hero-name, .hero-title, .hero-value, .hero-ctas',
        {
          opacity: [0, 1],
          y: [30, 0]
        },
        {
          duration: 0.8,
          easing: [0.16, 1, 0.3, 1],
          delay: stagger(0.15, { start: isDesktop ? 0.6 : 0 }) // Wait for patterns on desktop
        }
      );
    } else {
      // If reduced motion, just show content immediately
      document.querySelectorAll('.hero-name, .hero-title, .hero-value, .hero-ctas').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
      });
    }
  }

  // Run on initial load AND after every View Transition
  document.addEventListener('astro:page-load', animateHero);
</script>
