---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Display from '../components/typography/Display.astro';
import Body from '../components/typography/Body.astro';
---

<Layout title="Saad Shahd - Software Engineer">
  <!-- Centered content on top of patterns -->
  <div class="max-w-6xl mx-auto px-4 md:px-6 relative" style="z-index: 1;">
    <section class="md:min-h-[calc(100vh-5rem)] min-h-[calc(100vh-10rem)] flex flex-col justify-center items-center text-center">
      <Display level={1} as="h1" class="hero-name mb-6 leading-tight opacity-0 max-w-[42.5rem] text-balance">
        Saad Shahd
      </Display>
      <Body size="lg" as="p" class="hero-title text-accent-light mb-6 opacity-0 max-w-[42.5rem] text-balance">
        Building realtime systems through functional architecture
      </Body>
      <Body size="lg" as="p" class="hero-value text-neutral mb-12 leading-relaxed opacity-0 max-w-[42.5rem] text-balance">
        I design systems where illegal states can't exist.
        When you separate behavior from state, reliability isn't a feature—it's inevitable.
        That's functional architecture in production.
      </Body>
      <div class="hero-ctas flex gap-4 justify-center opacity-0">
        <Button variant="primary" size="lg" href="/portfolio">
          View Work
        </Button>
        <Button variant="secondary" size="lg" href="/contact">
          Get in Touch
        </Button>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { animate, stagger } from 'motion';
  import type { DOMKeyframesDefinition } from 'motion';

  function animateHero() {
    // Guard: Only run if hero elements exist (prevents errors on other pages)
    const heroElements = document.querySelectorAll('.hero-name, .hero-title, .hero-value, .hero-ctas');
    if (heroElements.length === 0) return;

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.innerWidth >= 1024;

    if (!prefersReducedMotion) {
      // Content: Animate hero elements with staggered timing
      // ✅ Type-safe Motion One usage: individual transform properties, not transform strings
      const keyframes: DOMKeyframesDefinition = {
        opacity: [0, 1],
        y: [30, 0] // Use 'y' property instead of transform: "translateY()"
      };

      animate('.hero-name, .hero-title, .hero-value, .hero-ctas', keyframes, {
        duration: 0.8,
        delay: stagger(0.15, { startDelay: isDesktop ? 0.6 : 0 }) // Wait for patterns on desktop
      });
    } else {
      // If reduced motion, just show content immediately
      heroElements.forEach(el => {
        (el as HTMLElement).style.opacity = '1';
      });
    }
  }

  // Run on initial load AND after every View Transition
  document.addEventListener('astro:page-load', animateHero);
</script>
