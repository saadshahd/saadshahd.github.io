---
/**
 * Callout Demo - Component showcase for Callout with optional CTA slot
 * Shows all semantic variants and usage patterns (with and without CTAs)
 */

import Callout from '../components/Callout.astro';
import Button from '../components/Button.astro';
import Body from '../components/typography/Body.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Callout Component Demo">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-4 text-text">Callout Component Demo</h1>
    <Body size="lg" class="mb-12 text-text-light">
      Unified callout component with optional CTA slot composition. Shows all 5 semantic variants with and without actions.
    </Body>

    <!-- Primary Variant WITHOUT CTA -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Primary Variant (Gold) - No Action</h2>

      <Callout
        variant="primary"
        title="Key Insight"
        icon="lightbulb"
      >
        <Body size="sm">
          Making illegal states unrepresentable eliminated entire classes of bugs. When the compiler enforces correctness, production incidents become structurally impossible.
        </Body>
      </Callout>
    </section>

    <!-- Primary Variant WITH CTA Slot -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Primary Variant (Gold) - With CTA Slot</h2>

      <Callout
        variant="primary"
        title="For Engineers: Technical Deep Dive Available"
        icon="code"
      >
        <Body size="sm">
          ANTLR grammar specifications, XState machine configurations, claims-based metadata architecture,
          and production debugging strategies from the Statsbomb real-time collection system.
        </Body>
        <Fragment slot="cta">
          <Button variant="ghost" size="sm" href="#technical">
            View Technical Appendix →
          </Button>
        </Fragment>
      </Callout>
    </section>

    <!-- Secondary Variant -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Secondary Variant (Blue) - Multiple CTAs</h2>

      <Callout
        variant="secondary"
        title="Ready to discuss your project?"
        icon="info"
      >
        <Body size="sm">
          Let's explore how functional architecture patterns and production-proven systems
          thinking can solve your team's engineering challenges.
        </Body>
        <Fragment slot="cta">
          <Button variant="primary" size="sm" href="/contact">
            Start a Conversation
          </Button>
          <Button variant="ghost" size="sm" href="/portfolio">
            View Case Studies →
          </Button>
        </Fragment>
      </Callout>
    </section>

    <!-- Warning Variant -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Warning Variant (Amber)</h2>

      <Callout
        variant="warning"
        title="⚠️ Breaking Change Notice"
        icon="alert"
      >
        <Body size="sm">
          The authentication API will be updated next week. Please review the migration guide
          and update your integration before the deadline.
        </Body>
        <Fragment slot="cta">
          <Button variant="ghost" size="sm" href="#migration">
            View Migration Guide
          </Button>
        </Fragment>
      </Callout>
    </section>

    <!-- Success Variant -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Success Variant (Emerald)</h2>

      <Callout
        variant="success"
        title="✅ Implementation Complete"
        icon="lightbulb"
      >
        <Body size="sm">
          The new feature has been deployed successfully! Check out the documentation
          to learn how to use it in your projects.
        </Body>
        <Fragment slot="cta">
          <Button variant="ghost" size="sm" href="#docs">
            Read Documentation
          </Button>
        </Fragment>
      </Callout>
    </section>

    <!-- Neutral Variant -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Neutral Variant (Gray)</h2>

      <Callout
        variant="neutral"
        title="Further Reading"
        icon="layers"
      >
        <Body size="sm">
          For more context on architectural decision records and their role in production systems,
          see the referenced articles and research papers.
        </Body>
        <Fragment slot="cta">
          <Button variant="ghost" size="sm" href="#references">
            View References
          </Button>
        </Fragment>
      </Callout>
    </section>

    <!-- Size Variants -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Size Variants</h2>

      <div class="space-y-6">
        <Callout
          variant="secondary"
          size="default"
          title="Default Size"
          icon="info"
        >
          <Body size="sm">
            Standard padding (24px). Best for primary page sections.
          </Body>
          <Fragment slot="cta">
            <Button variant="ghost" size="sm" href="#">Action</Button>
          </Fragment>
        </Callout>

        <Callout
          variant="secondary"
          size="compact"
          title="Compact Size"
          icon="info"
        >
          <Body size="sm">
            Reduced padding (16px). Good for sidebars or dense layouts.
          </Body>
          <Fragment slot="cta">
            <Button variant="ghost" size="sm" href="#">Action</Button>
          </Fragment>
        </Callout>

        <Callout
          variant="secondary"
          size="inline"
          title="Inline Size"
          icon="info"
        >
          <Body size="sm">
            Minimal padding (12px). For tight inline contexts.
          </Body>
          <Fragment slot="cta">
            <Button variant="ghost" size="sm" href="#">Action</Button>
          </Fragment>
        </Callout>
      </div>
    </section>

    <!-- Usage Code Examples -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Usage Examples</h2>

      <div class="bg-surface rounded-lg p-6 border border-neutral-light">
        <h3 class="text-lg font-semibold mb-4 text-text">Without CTA Slot (Information Only)</h3>
        <pre class="bg-background p-4 rounded overflow-x-auto text-sm"><code>&lt;Callout variant="primary" title="Key Insight" icon="lightbulb"&gt;
  &lt;Body size="sm"&gt;
    Your informational content goes here...
  &lt;/Body&gt;
&lt;/Callout&gt;</code></pre>

        <h3 class="text-lg font-semibold mb-4 mt-8 text-text">With CTA Slot (Single Action)</h3>
        <pre class="bg-background p-4 rounded overflow-x-auto text-sm"><code>&lt;Callout variant="secondary" title="Title Here" icon="info"&gt;
  &lt;Body size="sm"&gt;
    Your content goes here...
  &lt;/Body&gt;
  &lt;Fragment slot="cta"&gt;
    &lt;Button variant="ghost" size="sm" href="/path"&gt;
      Action Label →
    &lt;/Button&gt;
  &lt;/Fragment&gt;
&lt;/Callout&gt;</code></pre>

        <h3 class="text-lg font-semibold mb-4 mt-8 text-text">With CTA Slot (Multiple Actions)</h3>
        <pre class="bg-background p-4 rounded overflow-x-auto text-sm"><code>&lt;Callout variant="primary" title="Ready to start?"&gt;
  &lt;Body size="sm"&gt;Content...&lt;/Body&gt;
  &lt;Fragment slot="cta"&gt;
    &lt;Button variant="primary" size="sm" href="/start"&gt;
      Get Started
    &lt;/Button&gt;
    &lt;Button variant="ghost" size="sm" href="/learn"&gt;
      Learn More →
    &lt;/Button&gt;
  &lt;/Fragment&gt;
&lt;/Callout&gt;</code></pre>
      </div>
    </section>

    <!-- Design System Info -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6 text-text">Design System Guidelines</h2>

      <div class="bg-surface rounded-lg p-6 border border-neutral-light">
        <h3 class="text-lg font-semibold mb-4 text-text">When to Use CTA Slot</h3>
        <ul class="list-disc ml-6 space-y-2 text-text-lighter">
          <li><strong>Informational content with dedicated action button</strong> - Technical appendix links, migration guides</li>
          <li><strong>Context + CTA combinations</strong> - Feature announcements with "Learn More" buttons</li>
          <li><strong>Multiple related actions</strong> - Primary + secondary CTAs (max 2-3 buttons)</li>
          <li><strong>Visual separation needed</strong> - Border-top separator emphasizes the action section</li>
        </ul>

        <h3 class="text-lg font-semibold mb-4 mt-6 text-text">When NOT to Use CTA Slot</h3>
        <ul class="list-disc ml-6 space-y-2 text-text-lighter">
          <li><strong>No action needed</strong> - Information only (lessons, insights, context)</li>
          <li><strong>Inline link sufficient</strong> - Use <code class="bg-background px-2 py-1 rounded">&lt;Link&gt;</code> in default slot content</li>
          <li><strong>Promotional content</strong> - Use <code class="bg-background px-2 py-1 rounded">&lt;Card&gt;</code> with manual Button placement instead</li>
        </ul>

        <h3 class="text-lg font-semibold mb-4 mt-6 text-text">Accessibility Features</h3>
        <ul class="list-disc ml-6 space-y-2 text-text-lighter">
          <li><code class="bg-background px-2 py-1 rounded">role="complementary"</code> for semantic HTML</li>
          <li><code class="bg-background px-2 py-1 rounded">aria-labelledby</code> connects title to callout</li>
          <li><code class="bg-background px-2 py-1 rounded">role="group"</code> for CTA section</li>
          <li>WCAG AA color contrast (7.2-9.1:1 for semantic variants)</li>
          <li>Button components enforce 44x44px minimum touch targets</li>
          <li>Keyboard navigation via Button component focus management</li>
        </ul>

        <h3 class="text-lg font-semibold mb-4 mt-6 text-text">Responsive Behavior</h3>
        <ul class="list-disc ml-6 space-y-2 text-text-lighter">
          <li><strong>Desktop</strong> - Horizontal CTA layout (buttons side-by-side)</li>
          <li><strong>Mobile</strong> - Buttons stack vertically via <code class="bg-background px-2 py-1 rounded">flex-wrap</code></li>
          <li><strong>Spacing</strong> - Fibonacci sequence (24px/16px/12px based on size variant)</li>
        </ul>
      </div>
    </section>

    <!-- Back to Home -->
    <div class="text-center">
      <Button variant="secondary" href="/">
        ← Back to Home
      </Button>
    </div>
  </main>
</Layout>
