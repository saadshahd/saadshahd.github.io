---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume - Saad Shahd">
  <div class="max-w-4xl mx-auto px-6 py-20">
    <div class="flex justify-between items-start mb-12">
      <h1 class="text-5xl font-bold">Resume</h1>
      <a
        href="/resume.pdf"
        class="px-6 py-3 border border-black hover:bg-gray-50 transition-colors"
        download
      >
        Download PDF
      </a>
    </div>

    <div class="prose prose-lg max-w-none">
      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4">Experience</h2>
        <div class="space-y-8">
          <div>
            <h3 class="text-xl font-semibold">Principal Engineer</h3>
            <p class="text-gray-600">Company Name • 2020 - Present</p>
            <ul class="mt-2 space-y-1 text-gray-700">
              <li>[Achievement or responsibility]</li>
              <li>[Achievement or responsibility]</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-semibold mb-4">Education</h2>
        <div>
          <h3 class="text-xl font-semibold">[Degree]</h3>
          <p class="text-gray-600">[University] • [Year]</p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-4">Skills</h2>
        <p class="text-gray-700">[List your key technical skills]</p>
      </section>
    </div>
  </div>
</Layout>
