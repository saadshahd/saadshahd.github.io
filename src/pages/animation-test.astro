---
/**
 * Animation Test Page
 * Temporary page to verify RevealOnScroll component functionality
 * Delete after Week 3-4 animations are complete
 */
import RevealOnScroll from '../components/animations/RevealOnScroll.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Animation Test - RevealOnScroll">
  <main class="min-h-screen bg-background px-4 py-16">
    <div class="mx-auto max-w-4xl space-y-32">

      <!-- Header -->
      <section class="text-center">
        <h1 class="text-3xl font-bold text-accent mb-4"><span>RevealOnScroll Component Test</span></h1>
        <p class="text-base text-accent-light">
          Scroll down to trigger animations. Check prefers-reduced-motion in DevTools.
        </p>
      </section>

      <!-- Test 1: Basic Reveal -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 1: Basic Reveal (Default Settings)</span>
        </h2>
        <RevealOnScroll>
          <div class="bg-surface p-6 rounded-lg border border-accent">
            <h3 class="text-lg font-semibold text-accent mb-2"><span>Default Animation</span></h3>
            <p class="text-accent-light">
              This uses default settings: delay=0, duration=0.618s, amount=0.3
            </p>
            <p class="text-accent-light mt-2">
              Golden ratio timing (0.618s) with Egyptian "water" easing.
            </p>
          </div>
        </RevealOnScroll>
      </section>

      <!-- Test 2: Staggered Reveals -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 2: Staggered Delays</span>
        </h2>
        <div class="grid gap-6">
          <RevealOnScroll delay={0}>
            <div class="bg-surface p-6 rounded-lg border border-accent">
              <h3 class="text-lg font-semibold text-accent"><span>First (delay=0s)</span></h3>
              <p class="text-accent-light">Appears immediately when in view</p>
            </div>
          </RevealOnScroll>

          <RevealOnScroll delay={0.2}>
            <div class="bg-surface p-6 rounded-lg border border-accent">
              <h3 class="text-lg font-semibold text-accent"><span>Second (delay=0.2s)</span></h3>
              <p class="text-accent-light">Appears 200ms after first</p>
            </div>
          </RevealOnScroll>

          <RevealOnScroll delay={0.4}>
            <div class="bg-surface p-6 rounded-lg border border-accent">
              <h3 class="text-lg font-semibold text-accent"><span>Third (delay=0.4s)</span></h3>
              <p class="text-accent-light">Appears 400ms after first</p>
            </div>
          </RevealOnScroll>
        </div>
      </section>

      <!-- Test 3: Custom Duration -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 3: Custom Duration</span>
        </h2>
        <RevealOnScroll duration={1.5}>
          <div class="bg-surface p-6 rounded-lg border border-accent">
            <h3 class="text-lg font-semibold text-accent"><span>Slow Reveal (1.5s)</span></h3>
            <p class="text-accent-light">
              Longer duration for deliberate, dramatic entrance.
            </p>
          </div>
        </RevealOnScroll>
      </section>

      <!-- Test 4: Custom Intersection Threshold -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 4: Intersection Threshold</span>
        </h2>
        <RevealOnScroll amount={0.8}>
          <div class="bg-surface p-6 rounded-lg border border-accent">
            <h3 class="text-lg font-semibold text-accent"><span>Late Trigger (amount=0.8)</span></h3>
            <p class="text-accent-light">
              Only animates when 80% of element is visible. Scroll all the way down!
            </p>
          </div>
        </RevealOnScroll>
      </section>

      <!-- Test 5: Typography Content -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 5: Real Content (Case Study Preview)</span>
        </h2>
        <RevealOnScroll>
          <article class="prose prose-slate max-w-none">
            <h3 class="text-lg font-bold text-accent"><span>Real-Time Data Collection System</span></h3>
            <p class="text-accent-light">
              We built a distributed system to collect football event data from 10,000+
              matches per season. The challenge: guarantee 100% data integrity while
              processing 50M+ events/day across unreliable networks.
            </p>
            <p class="text-accent-light">
              Our solution combined CQRS for write separation, event sourcing for audit
              trails, and CDC (Change Data Capture) for real-time replication.
            </p>
          </article>
        </RevealOnScroll>
      </section>

      <!-- Test 6: Multiple Elements -->
      <section class="space-y-8">
        <h2 class="text-xl font-bold text-accent border-l-4 border-primary pl-4">
          <span>Test 6: Multiple Reveals on Scroll</span>
        </h2>
        <RevealOnScroll>
          <h3 class="text-lg font-semibold text-accent mb-4"><span>Architecture Decision</span></h3>
        </RevealOnScroll>
        <RevealOnScroll delay={0.2}>
          <p class="text-accent-light mb-4">
            Each section animates independently with staggered timing.
          </p>
        </RevealOnScroll>
        <RevealOnScroll delay={0.4}>
          <div class="bg-surface p-4 rounded border border-accent">
            <code class="text-sm text-accent">
              PostgreSQL + JSONB columns for flexible schema
            </code>
          </div>
        </RevealOnScroll>
      </section>

      <!-- Spacer for scroll testing -->
      <div class="h-screen flex items-center justify-center">
        <p class="text-accent-light text-sm">
          Scroll up and down to re-trigger animations (should only play once per element)
        </p>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Test page specific styles */
  .prose {
    color: inherit;
  }

  .prose h3 {
    margin-top: 0;
  }
</style>
