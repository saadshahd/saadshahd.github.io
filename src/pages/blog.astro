---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Heading from '../components/typography/Heading.astro';
import Body from '../components/typography/Body.astro';
import Link from '../components/Link.astro';
---

<Layout title="Blog - Saad Shahd">
  <Container width="default" spacing="default">
    <Heading level={1} as="h1" class="mb-4"><span>Blog</span></Heading>
    <Body size="xl" as="p" class="text-text-lighter mb-8">
      Technical articles on systems, architecture, and engineering practices
    </Body>

    <Body size="base" as="p" class="text-text mb-6 leading-relaxed">
      <strong>First post coming soon:</strong> Real-Time Data Collection System — how DSLs, state machines, and event sourcing scaled Statsbomb collection without engineering bottlenecks.
    </Body>
    <Body size="sm" as="p" class="text-text-lighter">
      Want to discuss systems architecture, functional programming patterns, or eliminating complexity before it exists? <Link href="/contact" variant="inline">Start a conversation →</Link>
    </Body>
  </Container>
</Layout>
