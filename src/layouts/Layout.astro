---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Link from '../components/Link.astro';
import SSLogo from '../components/SSLogo.astro';
import BottomTabBar from '../components/navigation/BottomTabBar.astro';
import TabItem from '../components/navigation/TabItem.astro';
import { House, BriefcaseBusiness, VenetianMask, Atom, Send } from '@lucide/astro';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  disableAutoHideNav?: boolean;
}

const {
  title,
  description = 'Building realtime systems that scale through functional architecture and separation of concerns',
  ogImage = '/og-image.png',
  disableAutoHideNav = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="Saad Shahd" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saad Shahd" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-display" preload />
    <ClientRouter />

    <!-- Umami Analytics: Privacy-first, cookie-free tracking -->
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="348f2ca9-68a7-422f-849c-36aff2630c8a"
    ></script>

    <!-- Update active tab state after View Transitions -->
    <script>
      // Normalize pathname by removing trailing slash (except root)
      const normalizePath = (path: string): string => {
        if (path === '/') return '/';
        return path.replace(/\/$/, '');
      };

      document.addEventListener('astro:after-swap', () => {
        const currentPath = normalizePath(window.location.pathname);
        const tabs = document.querySelectorAll('nav[aria-label="Mobile navigation"] a');

        tabs.forEach((tab) => {
          const href = tab.getAttribute('href');
          if (!href) return;

          const normalizedHref = normalizePath(href);
          const isActive = normalizedHref === currentPath
            || (normalizedHref !== '/' && currentPath.startsWith(normalizedHref + '/'));

          if (isActive) {
            tab.classList.add('text-accent', 'scale-105');
            tab.classList.remove('text-text-lighter');
            tab.setAttribute('aria-current', 'page');
          } else {
            tab.classList.remove('text-accent', 'scale-105');
            tab.classList.add('text-text-lighter');
            tab.removeAttribute('aria-current');
          }
        });
      });
    </script>

    <!-- Auto-hide desktop navigation on scroll -->
    <script>
      import Headroom from 'headroom.js';

      // Expose headroom globally so other scripts can freeze/unfreeze during programmatic scrolls
      declare global {
        interface Window {
          headroomInstance?: Headroom | null;
        }
      }

      document.addEventListener('astro:page-load', () => {
        const nav = document.getElementById('desktop-nav');
        if (!nav) return;

        // Check if page opted out of auto-hide behavior
        const disableAutoHide = nav.dataset.disableAutoHide === 'true';

        // Destroy previous instance to prevent memory leaks
        if (window.headroomInstance) {
          window.headroomInstance.destroy();
          window.headroomInstance = null;
        }

        // Skip initialization if page disabled auto-hide
        if (disableAutoHide) return;

        // Initialize headroom with threshold and tolerance settings
        window.headroomInstance = new Headroom(nav, {
          offset: 50,         // Hide after scrolling down 50px
          tolerance: {
            up: 10,           // Show after scrolling up 10px
            down: 10          // Hide after scrolling down 10px past offset
          }
        });
        window.headroomInstance.init();
      });
    </script>

    <!--
      Mermaid client-side rendering with View Transitions support

      The astro-mermaid integration has a bug where it only registers the astro:after-swap
      listener if the FIRST page loaded contains diagrams. If users land on a page without
      diagrams (e.g., homepage), the listener is never registered, breaking all subsequent
      navigations to pages with diagrams.

      This script unconditionally registers astro:page-load listener to ensure diagrams
      render on every navigation, regardless of entry point.
    -->
    <script>
      // Register unconditionally (not conditional like integration's astro:after-swap)
      document.addEventListener('astro:page-load', async () => {
        // Only check for unprocessed diagrams (integration may have already processed some)
        const unprocessedDiagrams = document.querySelectorAll('.mermaid:not([data-processed="true"])');

        if (unprocessedDiagrams.length === 0) return;

        // Dynamic import to avoid loading on pages without diagrams
        const { default: mermaid } = await import('mermaid');

        // Run on unprocessed diagrams only (prevents duplicate rendering)
        // mermaid.run() will use the config from astro-mermaid integration
        await mermaid.run({
          querySelector: '.mermaid:not([data-processed="true"])'
        });
      });
    </script>

    <!-- Scroll depth tracking for case study pages -->
    <script>
      import '@/scripts/track-scroll-depth';
    </script>
  </head>
  <body class="bg-background text-text antialiased">
    <!-- Responsive Navigation: Mobile circular badge → Desktop bar -->
    <nav id="desktop-nav" class="headroom md:fixed md:mt-0 mt-8 top-2 left-2 right-2 max-w-6xl mx-auto z-50 rounded-lg md:bg-surface/80 md:backdrop-blur-lg flex items-center justify-center md:border md:border-neutral-lighter" data-disable-auto-hide={disableAutoHideNav}>
      <div class="flex items-center justify-center md:justify-between w-full px-4">
        <a href="/" class="hover:opacity-80 transition-opacity">
          <SSLogo />
        </a>
        <div class="hidden md:flex gap-8">
          <Link variant="nav" href="/" active={currentPath === '/'}>Home</Link>
          <Link variant="nav" href="/portfolio" active={currentPath === '/portfolio'}>Portfolio</Link>
          <Link variant="nav" href="/about" active={currentPath === '/about'}>About</Link>
          <Link variant="nav" href="/resume" active={currentPath === '/resume'}>Resume</Link>
          <Link variant="nav" href="/blog" active={currentPath === '/blog' || currentPath.startsWith('/blog/')}>Blog</Link>
          <Link variant="nav" href="/contact" active={currentPath === '/contact'}>Contact</Link>
        </div>
      </div>
    </nav>

    <!-- Mobile Bottom Tab Bar -->
    <BottomTabBar disableAutoHide={disableAutoHideNav}>
      <TabItem href="/" active={currentPath === '/'} label="Home">
        <House size={24} />
      </TabItem>

      <TabItem href="/portfolio" active={currentPath === '/portfolio'} label="Portfolio">
        <BriefcaseBusiness size={24} />
      </TabItem>

      <TabItem href="/about" active={currentPath === '/about'} label="About">
        <VenetianMask size={24} />
      </TabItem>

      <TabItem href="/blog" active={currentPath === '/blog' || currentPath.startsWith('/blog/')} label="Blog">
        <Atom size={24} />
      </TabItem>

      <TabItem href="/contact" active={currentPath === '/contact'} label="Contact">
        <Send size={24} />
      </TabItem>
    </BottomTabBar>

    <main class="md:pt-16 pb-20 md:pb-0">
      <slot />
    </main>
  </body>
</html>
