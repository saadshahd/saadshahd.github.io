---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Link from '../components/Link.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Principal Engineer specializing in real-time systems and functional architecture',
  ogImage = '/og-image.png'
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="Saad Shahd" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saad Shahd" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <ClientRouter />
    <style is:global>
      @media print {
        /* Page setup - minimal margins */
        @page {
          margin: 0.4in 0.5in;
          size: letter;
        }

        /* Hide navigation */
        nav {
          display: none !important;
        }

        /* Remove all padding from main */
        main {
          padding: 0 !important;
        }

        /* Compact layout for print */
        body {
          font-size: 10pt;
          line-height: 1.3;
        }

        /* Remove all container padding */
        .max-w-4xl {
          max-width: 100%;
          padding: 0 !important;
        }

        /* Minimal section spacing */
        section {
          margin-bottom: 0.75rem !important;
        }

        /* Compact headings */
        h1 {
          font-size: 22pt !important;
          margin-bottom: 0.15rem !important;
          line-height: 1.1 !important;
        }

        h2 {
          font-size: 12pt !important;
          margin-bottom: 0.35rem !important;
          margin-top: 0 !important;
          page-break-after: avoid;
        }

        h3 {
          font-size: 11pt !important;
          margin-bottom: 0.15rem !important;
          page-break-after: avoid;
        }

        /* Minimal paragraph spacing */
        p {
          margin-bottom: 0.25rem !important;
        }

        /* Compact list spacing */
        ul, ol {
          margin: 0.25rem 0 !important;
        }

        li {
          margin-bottom: 0.25rem !important;
          line-height: 1.3 !important;
        }

        /* Allow sections to break, but keep individual items together */
        .space-y-12 > div,
        ul,
        ol {
          page-break-inside: avoid;
        }

        /* Allow sections to flow across pages */
        section {
          page-break-inside: auto;
        }

        /* Clean link appearance */
        a {
          text-decoration: none;
          color: inherit;
        }

        /* Aggressive spacing reductions */
        .space-y-12 > * + * {
          margin-top: 0.5rem !important;
        }

        .space-y-6 > * + * {
          margin-top: 0.35rem !important;
        }

        .space-y-4 > * + * {
          margin-top: 0.25rem !important;
        }

        .space-y-3 > * + * {
          margin-top: 0.2rem !important;
        }

        .space-y-2 > * + * {
          margin-top: 0.15rem !important;
        }

        /* Minimal margins everywhere */
        .mb-16,
        .mb-12,
        .mb-8 {
          margin-bottom: 0.5rem !important;
        }

        .mb-6,
        .mb-4 {
          margin-bottom: 0.35rem !important;
        }

        .mb-3,
        .mb-2 {
          margin-bottom: 0.2rem !important;
        }

        .mt-4 {
          margin-top: 0.25rem !important;
        }

        .py-20,
        .py-16,
        .py-12,
        .py-8 {
          padding-top: 0 !important;
          padding-bottom: 0 !important;
        }

        .px-6 {
          padding-left: 0 !important;
          padding-right: 0 !important;
        }

        /* Compact header */
        .text-5xl {
          font-size: 22pt !important;
        }

        .text-xl {
          font-size: 11pt !important;
        }

        .text-lg {
          font-size: 10.5pt !important;
        }

        .text-2xl {
          font-size: 12pt !important;
        }

        /* Tighter flex gaps */
        .gap-4 {
          gap: 0.25rem !important;
        }
      }
    </style>
  </head>
  <body class="bg-background text-accent antialiased">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-sm border-b border-neutral-lighter">
      <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-lg font-sans font-semibold text-accent hover:text-neutral transition-colors">
            SS
          </a>
          <div class="flex gap-8">
            <Link variant="nav" href="/" active={currentPath === '/'}>Home</Link>
            <Link variant="nav" href="/portfolio" active={currentPath === '/portfolio'}>Portfolio</Link>
            <Link variant="nav" href="/about" active={currentPath === '/about'}>About</Link>
            <Link variant="nav" href="/resume" active={currentPath === '/resume'}>Resume</Link>
            <Link variant="nav" href="/blog" active={currentPath === '/blog'}>Blog</Link>
            <Link variant="nav" href="/contact" active={currentPath === '/contact'}>Contact</Link>
          </div>
        </div>
      </div>
    </nav>
    <main class="pt-20">
      <slot />
    </main>
  </body>
</html>
