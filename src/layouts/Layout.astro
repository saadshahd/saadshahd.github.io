---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Link from '../components/Link.astro';
import BottomTabBar from '../components/navigation/BottomTabBar.astro';
import TabItem from '../components/navigation/TabItem.astro';
import ScrollProgress from '../components/animations/ScrollProgress.astro';
import { House, BriefcaseBusiness, VenetianMask, Atom, Send } from '@lucide/astro';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Principal Engineer specializing in realtime systems and functional thinking',
  ogImage = '/og-image.png'
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="Saad Shahd" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saad Shahd" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <ClientRouter />

    <!-- Update active tab state after View Transitions -->
    <script>
      // Normalize pathname by removing trailing slash (except root)
      const normalizePath = (path: string): string => {
        if (path === '/') return '/';
        return path.replace(/\/$/, '');
      };

      document.addEventListener('astro:page-load', () => {
        const currentPath = normalizePath(window.location.pathname);
        const tabs = document.querySelectorAll('nav[aria-label="Mobile navigation"] a');

        tabs.forEach((tab) => {
          const href = tab.getAttribute('href');
          if (!href) return;

          const normalizedHref = normalizePath(href);
          const isActive = normalizedHref === currentPath;

          if (isActive) {
            tab.classList.add('text-accent', 'scale-105');
            tab.classList.remove('text-neutral');
            tab.setAttribute('aria-current', 'page');
          } else {
            tab.classList.remove('text-accent', 'scale-105');
            tab.classList.add('text-neutral');
            tab.removeAttribute('aria-current');
          }
        });
      });
    </script>
  </head>
  <body class="bg-background text-accent antialiased">
    <!-- Scroll Progress Indicator -->
    <ScrollProgress />

    <!-- Desktop Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-sm border-b border-neutral-lighter">
      <div class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-center md:justify-between">
          <a href="/" class="inline-block p-3 text-lg font-sans font-semibold text-accent hover:text-neutral transition-colors">
            SS
          </a>
          <div class="hidden md:flex gap-8">
            <Link variant="nav" href="/" active={currentPath === '/'}>Home</Link>
            <Link variant="nav" href="/portfolio" active={currentPath === '/portfolio'}>Portfolio</Link>
            <Link variant="nav" href="/about" active={currentPath === '/about'}>About</Link>
            <Link variant="nav" href="/resume" active={currentPath === '/resume'}>Resume</Link>
            <Link variant="nav" href="/blog" active={currentPath === '/blog'}>Blog</Link>
            <Link variant="nav" href="/contact" active={currentPath === '/contact'}>Contact</Link>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile Bottom Tab Bar -->
    <BottomTabBar>
      <TabItem href="/" active={currentPath === '/'} label="Home">
        <House size={24} />
      </TabItem>

      <TabItem href="/portfolio" active={currentPath === '/portfolio'} label="Portfolio">
        <BriefcaseBusiness size={24} />
      </TabItem>

      <TabItem href="/about" active={currentPath === '/about'} label="About">
        <VenetianMask size={24} />
      </TabItem>

      <TabItem href="/blog" active={currentPath === '/blog'} label="Blog">
        <Atom size={24} />
      </TabItem>

      <TabItem href="/contact" active={currentPath === '/contact'} label="Contact">
        <Send size={24} />
      </TabItem>
    </BottomTabBar>

    <main class="pt-20 pb-20 md:pb-0">
      <slot />
    </main>
  </body>
</html>
