---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    showScrollProgress?: boolean;
    disableAutoHideNav?: boolean;
    description?: string;
    ogImage?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout {...frontmatter}>
  <slot />
</Layout>
