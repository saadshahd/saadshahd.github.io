---
import { MessageSquareQuote } from '@lucide/astro';

interface Props {
  icon?: boolean;
  attribution?: string;
  class?: string;
}

const { icon = false, attribution, class: className } = Astro.props;
---

<blockquote class={`pl-4 my-6 border-text-lighter border-l-3 ${className || ''}`}>
  <div class="flex">
    {icon && (
      <div class="mr-3">
        <MessageSquareQuote class="w-10 h-10 text-neutral" />
      </div>
    )}
    <div class="text-text-lighter italic">
      <slot />
    </div>
  </div>
  {attribution && (
    <cite class="block text-sm not-italic text-text-lighter mt-3">— {attribution}</cite>
  )}
</blockquote>
