---
import { cva, type VariantProps } from 'class-variance-authority';
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/utils/cn';

const grid = cva(
  'grid gap-6',
  {
    variants: {
      spacing: {
        default: 'mb-8',
        compact: 'mb-6',
        spacious: 'mb-12',
      },
    },
    defaultVariants: {
      spacing: 'default',
    },
  }
);

interface Props extends HTMLAttributes<'div'>, VariantProps<typeof grid> {}

const {
  spacing,
  class: className,
  ...htmlAttrs
} = Astro.props;
---

<div class={cn(grid({ spacing }), 'md:grid-cols-2', className)} {...htmlAttrs}>
  <slot />
</div>
