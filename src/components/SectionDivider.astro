---
import { cn } from '@/utils/cn';

interface Props {
  spacing?: 'major' | 'subsection' | 'minor';
  class?: string;
}

const { spacing = 'major', class: className = '' } = Astro.props;

// Fibonacci-aligned spacing tokens from design system
const spacingMap = {
  major: 'my-8',       // 40px (spacing-xl in Fibonacci scale)
  subsection: 'my-6',   // 32px (standard section breaks)
  minor: 'my-4'         // 24px (tight grouping)
};
---

<div
  class={cn(`section-divider ${spacingMap[spacing]} ${className}`)}
  role="separator"
  aria-hidden="true"
>
  <hr class="border-neutral-light" />
</div>
