---
// TabItem - Composable tab for bottom navigation
// Accepts icon via slot for maximum flexibility

interface Props {
  href: string;
  active: boolean;
  label: string;
}

const { href, active, label } = Astro.props;
---

<a
  href={href}
  aria-current={active ? 'page' : undefined}
  class:list={[
    'flex flex-col items-center justify-center gap-1',
    'flex-1 max-w-[80px]',
    'min-w-[48px] min-h-[48px] px-3',
    'transition-all duration-300',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
    active ? 'text-primary scale-105' : 'text-neutral hover:text-accent'
  ]}
>
  <div class="w-6 h-6 flex items-center justify-center">
    <slot />
  </div>
  <span class="text-[11px] font-sans font-medium leading-tight text-center">
    {label}
  </span>
</a>

<style>
  /* Disable scale animation for reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: color 0.3s ease;
    }
    a.scale-105 {
      transform: none;
    }
  }
</style>
