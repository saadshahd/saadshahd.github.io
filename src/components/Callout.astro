---
import { cva, type VariantProps } from 'class-variance-authority';
import { clsx } from 'clsx';
import { Triangle, Waves, AlertTriangle, Code2 } from '@lucide/astro';

// CVA variant definitions
const callout = cva(
  [
    'rounded-lg',
    '[&:not(:last-child)]:mb-6',
  ],
  {
    variants: {
      variant: {
        insight: 'bg-callout-insight-bg border-primary text-text', // Gold: Egyptian brand heritage
        context: 'bg-callout-context-bg border-secondary text-text', // Blue: Red Sea contextual information
        warning: 'bg-callout-warning-bg border-warning text-text', // Amber: Attention-requiring trade-offs
        technical: 'bg-callout-technical-bg border-success text-text', // Emerald: Implementation details
        subtle: 'bg-surface border-neutral-light text-text', // Neutral: Low-priority notes
      },
      size: {
        default: 'p-6 border-l-4',
        compact: 'p-4 border-l-3 text-sm',
        inline: 'p-3 border-l-2 text-sm',
      },
    },
    defaultVariants: {
      variant: 'insight',
      size: 'default',
    },
  }
);

const title = cva([
  'font-semibold',
  'text-text',
  'mb-3',
  'text-base',
]);

const content = cva([
  'text-text-lighter',
  'leading-relaxed',
  '[&>p]:mb-4',
  '[&>p:last-child]:mb-0', // Remove bottom margin from last paragraph
]);

type Props = VariantProps<typeof callout> & {
  title?: string;
  class?: string;
  showIcon?: boolean; // Optional icon display
};

const {
  variant = 'insight',
  size = 'default',
  title: titleText,
  class: className,
  showIcon = true, // Icons enabled by default
} = Astro.props;

// Icon mapping for variants (Egyptian-themed Lucide icons)
const iconMap = {
  insight: Triangle,      // Pyramid → architectural wisdom
  context: Waves,         // Water → background/domain
  warning: AlertTriangle, // Sun/caution → attention
  technical: Code2,       // Lotus/code → implementation
  subtle: undefined,      // No icon for subtle variant
} as const;

const IconComponent = variant ? iconMap[variant] : undefined;
---

<aside class={clsx(callout({ variant, size }), className)} role="note">
  {titleText && (
    <div class={clsx(title(), 'flex items-center gap-2')}>
      {showIcon && IconComponent && (
        <IconComponent class="w-5 h-5 flex-shrink-0" />
      )}
      <span>{titleText}</span>
    </div>
  )}
  <div class={content()}>
    <slot />
  </div>
</aside>
