---
import { cva, type VariantProps } from 'class-variance-authority';
import { clsx } from 'clsx';
import { Lightbulb, Layers, AlertTriangle, Code2, MessageSquareQuote, Info } from '@lucide/astro';

// CVA variant definitions - STYLE ONLY (colors/borders)
const callout = cva(
  [
    'rounded-lg',
    '[&:not(:last-child)]:mb-6',
  ],
  {
    variants: {
      variant: {
        primary: 'bg-callout-insight-bg border-primary text-text', // Gold: Brand/emphasis
        secondary: 'bg-callout-context-bg border-secondary text-text', // Blue: Contextual information
        warning: 'bg-callout-warning-bg border-warning text-text', // Amber: Attention-requiring trade-offs
        success: 'bg-callout-technical-bg border-success text-text', // Emerald: Success/completion
        neutral: 'bg-surface border-neutral-light text-text', // Gray: Low-priority/quotes
      },
      size: {
        default: 'p-6 border-l-4',
        compact: 'p-4 border-l-3 text-sm',
        inline: 'p-3 border-l-2 text-sm',
      },
    },
    defaultVariants: {
      variant: 'primary',
      size: 'default',
    },
  }
);

const title = cva([
  'font-semibold',
  'text-text',
  'mb-3',
  'text-base',
]);

const content = cva([
  'text-text-lighter',
  'leading-relaxed',
  '[&>p]:mb-4',
  '[&>p:last-child]:mb-0', // Remove bottom margin from last paragraph
]);

// CTA section styling - cohesive with parent Callout variant
const ctaSection = cva(
  [
    'flex',
    'flex-wrap',
    'gap-3',
    'items-center',
    'border-t',
  ],
  {
    variants: {
      variant: {
        primary: 'border-primary/20',      // Gold accent (matches callout left border)
        secondary: 'border-secondary/20',  // Blue accent
        warning: 'border-warning/20',      // Amber accent
        success: 'border-success/20',      // Emerald accent
        neutral: 'border-neutral/30',      // Gray (higher opacity for visibility)
      },
      size: {
        default: 'pt-6 mt-6',  // 24px Fibonacci spacing
        compact: 'pt-4 mt-4',  // 16px Fibonacci spacing
        inline: 'pt-3 mt-3',   // 12px Fibonacci spacing
      },
    },
    defaultVariants: {
      variant: 'primary',
      size: 'default',
    },
  }
);

// Icon type - SEMANTIC ONLY
type IconName = 'lightbulb' | 'layers' | 'alert' | 'code' | 'quote' | 'info' | 'none';

type Props = VariantProps<typeof callout> & {
  title?: string;
  class?: string;
  icon?: IconName; // Explicit semantic choice
};

const {
  variant = 'primary',
  size = 'default',
  title: titleText,
  class: className,
  icon = 'lightbulb', // Default to lightbulb for insights
} = Astro.props;

// Icon mapping - semantic meaning to Lucide component
const iconMap = {
  lightbulb: Lightbulb,           // Lessons/insights/"aha moments"
  layers: Layers,                 // Architectural structure/systems
  alert: AlertTriangle,           // Warnings/trade-offs
  code: Code2,                    // Technical implementation
  quote: MessageSquareQuote,      // User voice/testimonials
  info: Info,                     // Background information
  none: undefined,                // Explicitly no icon
} as const;

const IconComponent = iconMap[icon];
---

<aside class={clsx(callout({ variant, size }), className)} role="note">
  {titleText && (
    <div class={clsx(title(), 'flex items-center gap-2')}>
      {IconComponent && (
        <IconComponent class="w-5 h-5 flex-shrink-0" />
      )}
      <span>{titleText}</span>
    </div>
  )}
  <div class={content()}>
    <slot />
  </div>

  {Astro.slots.has('cta') && (
    <div class={clsx(ctaSection({ variant, size }))} role="group" aria-label="Actions">
      <slot name="cta" />
    </div>
  )}
</aside>
