---
import { cva, type VariantProps } from 'class-variance-authority';

const button = cva(
  // Base styles matching design system .btn class
  'inline-flex items-center justify-center font-sans font-medium transition-all duration-200 ease-out-expo focus:outline-none focus:ring-3 focus:ring-primary focus:ring-offset-2 disabled:opacity-40 disabled:pointer-events-none',
  {
    variants: {
      variant: {
        // Primary: Egyptian gold background with dark text
        primary: 'bg-primary text-text border-2 border-primary hover:shadow-[0_8px_16px_rgba(244,196,48,0.2)] hover:border-primary-dark hover:scale-[1.02] active:scale-[0.98]',
        // Secondary: Gray-navy outline, hover to navy fill with white text
        secondary: 'bg-transparent text-text border-2 border-text-light hover:bg-text hover:text-surface hover:scale-[1.02] active:scale-[0.98]',
        // Ghost: Soft outline with callout-harmonizing color (blue accent), no scale animation
        ghost: 'bg-transparent text-secondary border-2 border-secondary/40 hover:border-secondary hover:shadow-[0_4px_12px_rgba(14,165,233,0.15)] transition-all duration-300',
      },
      size: {
        sm: 'px-2 py-1 text-xs md:px-4 md:py-2 md:text-sm rounded-md',
        md: 'px-4 py-2 text-sm md:px-6 md:py-2 md:text-base rounded-md',
        lg: 'px-4 py-2 text-sm md:px-6 md:py-4 md:text-base rounded-lg',
      },
    },
    defaultVariants: {
      variant: 'primary',
      size: 'md',
    },
  }
);

type Props = VariantProps<typeof button> & {
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  /**
   * Optional tracking label for analytics (location identifier)
   * Example: 'hero', 'footer', 'case-study-card'
   */
  trackLocation?: string;
};

const { variant, size, href, class: className, type = 'button', trackLocation } = Astro.props;

// Get button text for tracking (from slot content, will be passed via data attribute)
const buttonId = trackLocation ? `cta-${trackLocation}` : undefined;
---

{href ? (
  <a
    href={href}
    class={button({ variant, size, className })}
    data-track-location={trackLocation}
    data-track-destination={href}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={button({ variant, size, className })}
    data-track-location={trackLocation}
  >
    <slot />
  </button>
)}

{/* Client-side tracking script (runs once per page) */}
<script>
  import { trackCTAClick } from '@/utils/analytics';

  // Track all button/link clicks with data-track-location attribute
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest('[data-track-location]') as HTMLElement;

    if (!button) return;

    const location = button.getAttribute('data-track-location');
    const destination = button.getAttribute('data-track-destination');
    const text = button.textContent?.trim() || '';

    if (location) {
      trackCTAClick(location, text, destination || undefined);
    }
  });
</script>
