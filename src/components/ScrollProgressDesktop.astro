---
// ScrollProgressDesktop.astro
// Vertical scroll progress indicator for desktop (>768px)
// Displays in right margin with rotated section title
---

<!-- Vertical progress bar: minimal scroll indicator -->
<div class="scroll-progress-desktop fixed right-4 top-1/4 bottom-1/4 z-30 w-1 bg-neutral-light/30 rounded-full overflow-hidden">
  <div
    class="absolute bottom-0 left-0 right-0 bg-primary transition-[height] duration-100"
    data-progress-bar-desktop
    style="height: 0%;"
  ></div>
</div>

<style>
  /* Entrance animation: slide in from right */
  @keyframes slideInRight {
    from {
      transform: translateX(20px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .scroll-progress-desktop {
    animation: slideInRight 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Accessibility: disable animations for users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-desktop {
      animation: none;
    }
  }
</style>

<script>
  // Prevent double initialization
  let isInitialized = false;

  const initScrollProgress = () => {
    // Guard: Prevent double initialization
    if (isInitialized) {
      return;
    }

    // DOM elements
    const progressBar = document.querySelector('[data-progress-bar-desktop]') as HTMLElement | null;

    if (!progressBar) {
      return;
    }

    isInitialized = true;

    // Progress tracking using native scroll events
    const updateProgress = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollTop = window.scrollY;
      const progress = scrollHeight > 0 ? scrollTop / scrollHeight : 0;

      progressBar.style.height = `${progress * 100}%`;
    };

    // Attach scroll listener
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress(); // Set initial progress

    // Cleanup for Astro View Transitions
    const cleanup = () => {
      window.removeEventListener('scroll', updateProgress);
      isInitialized = false; // Reset for next page
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  // Initialize on page load (handles both initial load + View Transitions)
  document.addEventListener('astro:page-load', initScrollProgress);
</script>
