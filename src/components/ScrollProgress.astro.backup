---
interface Props {
  showSectionTitle?: boolean;
}

const { showSectionTitle = true } = Astro.props;
---

<div class="scroll-progress fixed top-16 left-0 right-0 z-30 bg-surface/95 backdrop-blur-sm border-b border-neutral-light">
  <div class="progress-bar bg-primary transition-[width] duration-100" data-progress-bar style="width: 0%; height: 3px;"></div>

  {showSectionTitle && (
    <div class="container max-w-4xl mx-auto px-4 py-2 flex justify-between items-center">
      <div class="section-title-wrapper">
        <span
          class="section-title text-sm font-medium text-accent"
          data-section-title
          data-animation="scale"
          style="will-change: transform, opacity;"
        >
          Loading...
        </span>
      </div>
      <span class="progress-percent text-xs text-text-lighter" data-progress-percent>0%</span>
    </div>
  )}
</div>

<script>
  import { animate, scroll, inView } from "motion";
  import { egyptianEasing, prefersReducedMotion } from "@/utils/animations";

  // State management
  interface State {
    current: string | null;
    transitionPromise: Promise<void> | null;
  }

  const state: State = {
    current: null,
    transitionPromise: null
  };

  // Single queue for ALL transitions (eliminates cross-pattern races)
  const enqueueTransition = (fn: () => Promise<void>) => {
    state.transitionPromise = (state.transitionPromise || Promise.resolve())
      .then(fn)
      .catch(() => {});
    return state.transitionPromise;
  };

  // Simple animation keyframes (atomic timeline)
  const simpleAnimations: Record<string, { out: any; in: any }> = {
    scale: {
      out: { scale: [1, 0.85], opacity: [1, 0] },
      in: { scale: [0.85, 1], opacity: [0, 1] }
    },
    blur: {
      // SIMPLIFIED: Removed CSS filter (caused visual glitches) - now just scale + opacity like "scale"
      out: { scale: [1, 0.9], opacity: [1, 0] },
      in: { scale: [0.9, 1], opacity: [0, 1] }
    },
    slide: {
      out: { y: [0, -30], opacity: [1, 0] },
      in: { y: [30, 0], opacity: [0, 1] }
    },
    rotate: {
      out: { rotate: [0, -90], x: [0, -100], opacity: [1, 0] },
      in: { rotate: [-90, 0], x: [-100, 0], opacity: [0, 1] }
    }
  };

  // Simple transitions (promise-chained with overlap)
  const transitionSimple = async (
    titleEl: HTMLElement,
    oldAnim: string,
    newAnim: string,
    newText: string
  ): Promise<void> => {
    // Animate out
    const outAnimation = animate(titleEl, simpleAnimations[oldAnim].out, {
      duration: 0.4,
      ease: egyptianEasing.pyramid
    });

    // Wait 0.3s (0.4 - 0.1 for overlap)
    await new Promise(resolve => setTimeout(resolve, 300));

    // Update text and animate in (overlaps with last 0.1s of out animation)
    titleEl.textContent = newText;
    await animate(titleEl, simpleAnimations[newAnim].in, {
      duration: 0.4,
      ease: egyptianEasing.pyramid
    }).finished;
  };

  // Complex transitions (DOM mutations, queued)
  const transitionComplex = async (
    type: 'split' | 'shuffle',
    titleEl: HTMLElement,
    oldText: string,
    newText: string
  ): Promise<void> => {
    if (type === 'split') {
      // Out: scatter characters (hieroglyphic breakdown)
      const oldChars = oldText.split('');
      titleEl.innerHTML = oldChars.map(c => `<span class="char inline-block">${c === ' ' ? '&nbsp;' : c}</span>`).join('');

      await animate(
        titleEl.querySelectorAll('.char'),
        {
          x: () => Math.random() * 100 - 50,
          y: () => Math.random() * 40 - 40,
          opacity: [1, 0]
        },
        {
          duration: 0.4,
          delay: (i: number) => i * 0.01,
          ease: egyptianEasing.water
        }
      ).finished;

      // Overlap delay
      await new Promise(r => setTimeout(r, 100));

      // In: gather characters from scatter
      const newChars = newText.split('');
      titleEl.innerHTML = newChars.map(c => `<span class="char inline-block">${c === ' ' ? '&nbsp;' : c}</span>`).join('');

      await animate(
        titleEl.querySelectorAll('.char'),
        {
          x: [() => Math.random() * 100 - 50, 0],
          y: [() => Math.random() * 40 - 40, 0],
          opacity: [0, 1]
        },
        {
          duration: 0.4,
          delay: (i: number) => i * 0.01,
          ease: egyptianEasing.water
        }
      ).finished;

    } else if (type === 'shuffle') {
      // Out: fade end-to-start (wisdom dissipating)
      const chars = oldText.split('');
      titleEl.innerHTML = chars.map(c => `<span class="char inline-block">${c === ' ' ? '&nbsp;' : c}</span>`).join('');

      await animate(
        titleEl.querySelectorAll('.char'),
        { opacity: [1, 0] },
        {
          duration: 0.02,
          delay: (i: number) => (chars.length - i - 1) * 0.03,
          ease: "linear"
        }
      ).finished;

      await new Promise(r => setTimeout(r, 100));

      // In: shuffle letters → reveal (wisdom reformation)
      const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const newChars = newText.split('');
      titleEl.innerHTML = '';

      const shufflePromises: Promise<void>[] = [];

      newChars.forEach((original, i) => {
        const span = document.createElement('span');
        span.className = 'char inline-block';
        span.textContent = original === ' ' ? '\u00A0' : letters[Math.floor(Math.random() * letters.length)];
        titleEl.appendChild(span);

        // Sequential shuffle animation with stagger
        const shuffleChar = async () => {
          // Wait for stagger delay
          await new Promise(resolve => setTimeout(resolve, i * 30)); // i * 0.03s

          // First shuffle
          span.textContent = letters[Math.floor(Math.random() * letters.length)];
          await new Promise(resolve => setTimeout(resolve, 30)); // 0.03s

          // Second shuffle
          span.textContent = letters[Math.floor(Math.random() * letters.length)];
          await new Promise(resolve => setTimeout(resolve, 30)); // 0.03s

          // Reveal original
          span.textContent = original === ' ' ? '\u00A0' : original;
          await animate(span, { opacity: [0, 1] }, { duration: 0.02, ease: "linear" }).finished;
        };

        shufflePromises.push(shuffleChar());
      });

      await Promise.all(shufflePromises);
    }
  };

  // Initialize when DOM is ready
  const initScrollProgress = () => {
    // DOM elements
    const titleEl = document.querySelector('[data-section-title]') as HTMLElement | null;
    const progressBar = document.querySelector('[data-progress-bar]') as HTMLElement | null;
    const progressPercent = document.querySelector('[data-progress-percent]') as HTMLElement | null;
    const sections = Array.from(document.querySelectorAll('[data-section]')) as HTMLElement[];

    if (!progressBar) {
      console.error('ScrollProgress: progress bar element not found');
      return;
    }

    if (!titleEl) {
      console.error('ScrollProgress: title element not found');
      return;
    }

    if (sections.length === 0) {
      console.warn('ScrollProgress: no sections with [data-section] found');
      return;
    }

    // 1. Progress tracking (ScrollTimeline optimized - runs off main thread)
    const stopProgressTracking = scroll((progress: number) => {
      progressBar.style.width = `${progress * 100}%`;
      if (progressPercent) {
        progressPercent.textContent = `${Math.round(progress * 100)}%`;
      }
    });

    // 2. Section detection (IntersectionObserver via inView)
    const sectionCleanups: Array<() => void> = sections.map(section =>
      inView(
        section,
        (element: Element) => {
          const htmlElement = element as HTMLElement;
          const newSection = htmlElement.dataset.section!;
          const newAnimation = htmlElement.dataset.animation || 'scale';

          console.log('[Observer Fired]', {
            newSection,
            currentState: state.current,
            willReturn: state.current === newSection,
            timestamp: Date.now()
          });

          if (state.current === newSection) return;

          enqueueTransition(async () => {
            if (prefersReducedMotion() || !titleEl) {
              titleEl.textContent = newSection;
              state.current = newSection;
              return;
            }

            const oldAnim = titleEl.dataset.animation || 'scale';
            const oldText = titleEl.textContent || '';

            // DISABLED: Complex animations (split/shuffle) are too slow for fast scrolling
            // Always use simple animations for responsive scroll tracking
            await transitionSimple(titleEl, oldAnim, newAnimation, newSection);

            console.log('[Animation Complete]', {
              newSection,
              oldAnim,
              newAnimation,
              timestamp: Date.now()
            });

            state.current = newSection;
            titleEl.dataset.animation = newAnimation;
          });
        },
        {
          amount: 0,  // Fire on any intersection (detection zone already constrains to one section)
          margin: "-20% 0px -75% 0px"  // Thin 5% detection zone at 20-25% from top (only one section at a time)
        }
      )
    );

    console.log('[Observers Setup]', {
      sectionCount: sections.length,
      sectionNames: sections.map(s => s.dataset.section),
      observerOptions: { amount: 0.2, margin: "-20% 0px -75% 0px" },
      timestamp: Date.now()
    });

    // Find and set initial visible section on page load
    const findInitialSection = (): HTMLElement | null => {
      const viewportHeight = window.innerHeight;
      const detectionTop = viewportHeight * 0.20;
      const detectionBottom = viewportHeight * 0.25;

      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= detectionBottom && rect.bottom >= detectionTop) {
          return section;
        }
      }
      // Fallback to first section if none in detection zone
      return sections.length > 0 ? sections[0] : null;
    };

    // Manually trigger initial state update (no animation on page load)
    const initialSection = findInitialSection();
    if (initialSection && titleEl) {
      const sectionName = initialSection.dataset.section!;
      const animation = initialSection.dataset.animation || "scale";
      const rect = initialSection.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const detectionTop = viewportHeight * 0.20;
      const detectionBottom = viewportHeight * 0.25;

      console.log('[Initial State]', {
        sectionName,
        rect: {
          top: rect.top,
          bottom: rect.bottom,
          height: rect.height
        },
        detectionZone: {
          top: detectionTop,
          bottom: detectionBottom,
          height: detectionBottom - detectionTop
        },
        viewportHeight,
        timestamp: Date.now()
      });

      state.current = sectionName;
      titleEl.textContent = sectionName;
      titleEl.dataset.animation = animation;
    }

    // Cleanup for Astro View Transitions
    const cleanup = () => {
      stopProgressTracking();
      sectionCleanups.forEach(stop => stop());
    };

    document.addEventListener('astro:before-swap', cleanup);
  };

  // Initialize on page load (handles both initial load and View Transitions)
  document.addEventListener('astro:page-load', initScrollProgress);
</script>

<style>
  .char {
    display: inline-block;
    min-width: 0.25em;
  }
</style>
