---
import { cva, type VariantProps } from 'class-variance-authority';
import { clsx } from 'clsx';

const card = cva(
  'block rounded-lg overflow-hidden transition-all',
  {
    variants: {
      variant: {
        'case-study': 'bg-surface border border-primary/15 hover:border-primary/40 hover:shadow-xl hover:-translate-y-1 p-0',
        'blog': 'bg-surface border border-neutral/15 hover:border-secondary/30 p-6',
        'minimal': 'bg-surface border border-neutral/10 hover:border-neutral/20 shadow-sm hover:shadow-md p-6',
      },
    },
    defaultVariants: {
      variant: 'minimal',
    },
  }
);

type Props = VariantProps<typeof card> & {
  href?: string;
  class?: string;
};

const { variant, href, class: className } = Astro.props;
const classes = clsx(card({ variant }), className);
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <article class={classes}>
    <slot />
  </article>
)}
