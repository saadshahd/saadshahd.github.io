---
/* Scroll-driven figure sequence. One pinned stage holds every figure; each
   beat's text card slides up and stacks over the previous one below the stage,
   crossfading the active figure as it arrives. Without JS, each beat renders
   as a static figure above its text. */
interface Beat {
  src: string;
  alt: string;
  label: string;
  labelColor?: string;
  paras: string[];
}

interface Props {
  /** CSS aspect-ratio shared by all figures, e.g. "1600/893". */
  aspect: string;
  beats: Beat[];
}

const { aspect, beats } = Astro.props;

const [aw, ah] = aspect.split('/').map(Number);
/* Stage height at any viewport: text cards park 16px below the pinned stage. */
const cardTop = `calc(min(720px, 100vw) * ${(ah / aw).toFixed(4)} + 16px)`;
---

<script is:inline>
  document.documentElement.classList.add('js');
</script>

<section class="figure-story relative">
  <div class="fs-frame sticky top-0 z-20 bg-gradient-to-b from-background from-84% to-background/0">
    <div class="relative mx-auto w-full max-w-[720px] px-6" style={`aspect-ratio: ${aspect};`}>
      {
        beats.map((b, i) => (
          <img
            src={b.src}
            alt=""
            aria-hidden="true"
            class:list={[
              'fs-img absolute inset-0 h-full w-full object-contain',
              i === 0 && 'fs-active',
            ]}
            loading="eager"
          />
        ))
      }
    </div>
  </div>
  <ol class="fs-beats mx-auto max-w-[720px] list-none px-6" style={`--fs-card-top: ${cardTop};`}>
    {
      beats.map((b) => (
        <li class="bg-background">
          <figure class="fs-fallback my-0">
            <img src={b.src} alt={b.alt} class="mb-4 w-full" style={`aspect-ratio: ${aspect};`} loading="lazy" />
          </figure>
          <p
            class="mb-2 font-mono text-[13px] tracking-[0.2em] text-text-lighter uppercase"
            style={b.labelColor ? `color: ${b.labelColor};` : undefined}
          >
            {b.label}
          </p>
          <div class="max-w-[42ch] font-serif text-[22px] leading-[1.6] text-text max-sm:text-[19px]">
            {b.paras.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style is:global>
  html:not(.js) .figure-story .fs-frame {
    display: none;
  }
  html.js .figure-story .fs-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  html.js .figure-story .fs-beats {
    padding-bottom: 25vh;
  }
  html.js .figure-story .fs-beats > li {
    position: sticky;
    top: var(--fs-card-top);
    min-height: calc(100svh - var(--fs-card-top));
    transition: opacity 0.4s ease;
  }
  html.js .figure-story .fs-beats > li.fs-done {
    opacity: 0;
  }
  html:not(.js) .figure-story .fs-beats > li {
    margin-top: 4rem;
  }
  .figure-story .fs-img {
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  .figure-story .fs-img.fs-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .figure-story .fs-img {
      transition: none;
    }
  }
</style>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>('.figure-story').forEach((story) => {
      const imgs = [...story.querySelectorAll<HTMLImageElement>('.fs-img')];
      const lis = [...story.querySelectorAll<HTMLElement>('.fs-beats > li')];
      let active = 0;
      const show = (next: number) => {
        active = next;
        imgs.forEach((img, i) => img.classList.toggle('fs-active', i === active));
        lis.forEach((li, i) => li.classList.toggle('fs-done', i < active));
      };

      /* The latest visible beat owns the stage: swap as soon as a beat's text
         enters the lower viewport; when the active beat scrolls back out through
         the bottom, the stage falls to the previous beat. */
      const visible = new Set<HTMLElement>();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const li = e.target as HTMLElement;
            if (e.isIntersecting) visible.add(li);
            else {
              visible.delete(li);
              const i = lis.indexOf(li);
              const exitedBottom = e.boundingClientRect.top > innerHeight / 2;
              if (!visible.size && exitedBottom && i === active && i > 0) show(i - 1);
            }
          });
          if (visible.size) show(Math.max(...[...visible].map((li) => lis.indexOf(li))));
        },
        { rootMargin: '0px 0px -15% 0px' }
      );
      lis.forEach((li) => io.observe(li));
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
