---
/* An ordered sequence of figures, each drawing welded to its caption. Panels
   stack down a single centered column with a calm, equal rhythm. Fully readable
   and ordered without JavaScript; a subtle scroll-linked entrance is layered on
   only where the browser supports view timelines and motion is welcome. */
interface Beat {
  src: string;
  alt: string;
  label?: string;
  labelColor?: string;
  paras: string[];
}

interface Props {
  /** CSS aspect-ratio shared by all figures, e.g. "1600/893". */
  aspect: string;
  beats: Beat[];
}

const { aspect, beats } = Astro.props;
---

<ol class="figure-story mx-auto max-w-[640px] list-none space-y-20 px-4 sm:space-y-28 sm:px-6">
  {
    beats.map((b) => (
      <li class="fs-panel">
        <figure class="my-0">
          <img
            src={b.src}
            alt={b.alt}
            class="fs-img w-full max-sm:-mx-4 max-sm:w-[calc(100%+2rem)]"
            style={`aspect-ratio: ${aspect};`}
            loading="lazy"
          />
          <figcaption class="mt-5">
            {b.label && (
              <p
                class="mb-2 font-mono text-[13px] tracking-[0.2em] text-text-lighter uppercase"
                style={b.labelColor ? `color: ${b.labelColor};` : undefined}
              >
                {b.label}
              </p>
            )}
            <div class="max-w-[42ch] font-serif text-[22px] leading-[1.6] text-text max-sm:text-[19px]">
              {b.paras.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
            </div>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ol>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .figure-story .fs-panel {
        opacity: 0;
        animation: fs-rise linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }

  @keyframes fs-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
