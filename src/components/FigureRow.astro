---
import { cva, type VariantProps } from 'class-variance-authority';
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/utils/cn';
import Figure from './Figure.astro';

/* Text renders first in the DOM so narrow screens keep the prose-then-image
   reading order; `side` places the figure at md+ by reversing or keeping row flow. */
const row = cva('my-8 flex flex-col gap-4 md:items-center md:gap-8', {
  variants: {
    side: {
      start: 'md:flex-row-reverse',
      end: 'md:flex-row',
    },
  },
  defaultVariants: {
    side: 'start',
  },
});

interface Props extends HTMLAttributes<'div'>, VariantProps<typeof row> {
  /**
   * Image source path
   */
  src: string;
  /**
   * Alt text for accessibility
   */
  alt: string;
}

const { src, alt, side, class: className, ...htmlAttrs } = Astro.props;
---

<div class={cn(row({ side }), className)} {...htmlAttrs}>
  <div class="min-w-0 md:w-1/2">
    <slot />
  </div>
  <Figure src={src} alt={alt} aspectRatio="auto" surface="none" class="my-0 w-full md:w-1/2" />
</div>
