---
// SSLogo.astro
// Inline animated SS logo for navigation with water-fill effect
---

<div class="ss-logo" role="img" aria-label="Saad Shahd">
  <svg viewBox="-5 0 140 120" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Water gradient: Red Sea blue rising from bottom -->
      <linearGradient id="water-gradient-logo" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#0EA5E9" stop-opacity="1" />
        <stop offset="50%" stop-color="#0EA5E9" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#06B6D4" stop-opacity="0.7" />
      </linearGradient>

      <!-- Clip path for water rising effect -->
      <clipPath id="water-rise-logo">
        <rect id="water-rect-logo" x="-5" y="120" width="140" height="0" />
      </clipPath>
    </defs>

    <!-- First S outline (Egyptian gold, always visible) -->
    <path
      d="m50 25c0-15-50-15-50 5S50 55 50 75 0 95 0 115"
      fill="none"
      stroke="#F4C430"
      stroke-width="9"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Second S outline (Egyptian gold, always visible) -->
    <path
      d="m125 25c0-15-50-15-50 5S125 55 125 75 75 95 75 115"
      fill="none"
      stroke="#F4C430"
      stroke-width="9"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- First S water stroke (clips from bottom to top) -->
    <path
      d="m50 25c0-15-50-15-50 5S50 55 50 75 0 95 0 115"
      fill="none"
      stroke="url(#water-gradient-logo)"
      stroke-width="9"
      stroke-linecap="round"
      stroke-linejoin="round"
      clip-path="url(#water-rise-logo)"
    />

    <!-- Second S water stroke (clips from bottom to top) -->
    <path
      d="m125 25c0-15-50-15-50 5S125 55 125 75 75 95 75 115"
      fill="none"
      stroke="url(#water-gradient-logo)"
      stroke-width="9"
      stroke-linecap="round"
      stroke-linejoin="round"
      clip-path="url(#water-rise-logo)"
    />
  </svg>
</div>

<style>
  .ss-logo {
    display: inline-block;
    width: 40px;
    height: 40px;
  }

  .ss-logo svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { animate } from 'motion';

  const MIN_DISPLAY_TIME = 500;
  let controller: AbortController | null = null;

  function setupLogoAnimation() {
    // Clean up previous page's listeners
    if (controller) {
      controller.abort();
    }

    // Create new controller for this page
    controller = new AbortController();
    const { signal } = controller;

    // Always get fresh reference to DOM element
    const waterRect = document.getElementById('water-rect-logo');
    if (!waterRect) {
      console.error('[SSLogo] Water rect not found');
      return;
    }

    // Page-scoped animation state
    let isAnimating = false;
    let showTime = 0;

    console.log('[SSLogo] Animation setup complete');

    // Listen to View Transition events
    document.addEventListener('astro:before-preparation', async () => {
      if (isAnimating) return;

      isAnimating = true;
      showTime = Date.now();

      console.log('[SSLogo] Phase 1: Staggered fill (40% → 65% → 90%)');

      // Reset rect position
      waterRect!.setAttribute('y', '120');
      waterRect!.setAttribute('height', '0');

      // Phase 1: Staggered fill using Motion One (600ms total)
      // SVG rect attributes animated directly
      // Stage 1: 0% → 40% (200ms)
      await animate(waterRect as any, { y: [120, 72], height: [0, 48] }, { duration: 0.2 }).finished;

      // Stage 2: 40% → 65% (200ms)
      await animate(waterRect as any, { y: [72, 42], height: [48, 78] }, { duration: 0.2 }).finished;

      // Stage 3: 65% → 90% (200ms)
      await animate(waterRect as any, { y: [42, 12], height: [78, 108] }, { duration: 0.2 }).finished;

      console.log('[SSLogo] Phase 1 complete: Holding at 90%');
    }, { signal });

    document.addEventListener('astro:after-preparation', async () => {
      if (!isAnimating) return;

      console.log('[SSLogo] Phase 2: Completing 90% → 100%');

      // Phase 2: Complete fill (200ms)
      await animate(waterRect as any, { y: [12, 0], height: [108, 120] }, { duration: 0.2 }).finished;

      console.log('[SSLogo] Phase 2 complete: 100% filled');

      // Phase 3: Ensure minimum display time before draining
      const elapsed = Date.now() - showTime;
      const remaining = Math.max(0, MIN_DISPLAY_TIME - elapsed);

      if (remaining > 0) {
        await new Promise(resolve => setTimeout(resolve, remaining));
      }

      console.log('[SSLogo] Phase 3: Draining water');

      // Phase 3: Drain animation (300ms)
      await animate(waterRect as any, { y: [0, 120], height: [120, 0] }, { duration: 0.3 }).finished;

      console.log('[SSLogo] Phase 3 complete: Drain finished');
      isAnimating = false;
    }, { signal });
  }

  // Run on page load
  document.addEventListener('astro:page-load', setupLogoAnimation);

  // Also run immediately in case page-load already fired
  if (document.readyState !== 'loading') {
    setupLogoAnimation();
  }
</script>
