---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../utils/cn';

const wavyUnderlineVariants = cva(
  'underline decoration-from-font decoration-wavy underline-offset-8',
  {
    variants: {
      color: {
        primary: 'decoration-primary-dark',    // Egyptian gold (#DAA520)
        secondary: 'decoration-secondary-dark', // Red Sea blue (#0369A1)
      },
    },
    defaultVariants: {
      color: 'primary',
    },
  }
);

type Props = VariantProps<typeof wavyUnderlineVariants> & {
  as?: 'span' | 'div' | 'p';
  class?: string;
};

const { color, as: Tag = 'span', class: className, ...rest } = Astro.props;
---

<Tag class:list={[cn(wavyUnderlineVariants({ color }), className)]} {...rest}>
  <slot />
</Tag>
