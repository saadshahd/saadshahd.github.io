---
import { cva, type VariantProps } from 'class-variance-authority';

const headingVariants = cva('font-semibold text-text text-balance', {
  variants: {
    level: {
      1: 'text-2xl md:text-3xl',      // 32px → 40px (page titles, content-first scale)
      2: 'text-xl md:text-2xl',       // 24px → 32px (section headings)
      3: 'text-lg md:text-xl',     // 20px → 24px (sub-section headings)
    },
  },
  defaultVariants: {
    level: 1,
  },
});

type Props = VariantProps<typeof headingVariants> & {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  class?: string;
};

const { level, as: Tag = 'h2', class: className } = Astro.props;
---

<Tag class:list={[headingVariants({ level }), className]}>
  <slot />
</Tag>
