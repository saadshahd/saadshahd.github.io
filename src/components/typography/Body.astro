---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../utils/cn';

const bodyVariants = cva('text-text-lighter', {
  variants: {
    size: {
      sm: 'text-sm leading-normal',              // 14px → 16.8px | small UI text stays sans
      base: 'text-base leading-relaxed',         // 16px → 19.2px | reading serif (Newsreader)
      lg: 'text-base lg:text-xl leading-relaxed',  // Mobile/Tablet: 16px → 19.2px | Desktop: 24px → 28.8px (reading serif)
      xl: 'text-xl leading-relaxed',             // 24px → 28.8px | reading serif (Newsreader)
    },
  },
  defaultVariants: {
    size: 'base',
  },
});

type Props = VariantProps<typeof bodyVariants> & {
  as?: 'p' | 'span' | 'div' | 'li' | 'ul' | 'a';
  class?: string;
};

const { size, as: Tag = 'p', class: className, ...rest } = Astro.props;

const fontFamily =
  size === 'sm'
    ? 'var(--font-family-sans)'
    : 'var(--font-family-serif)';
---

<Tag class:list={[cn(bodyVariants({ size }), className)]} style={`font-family: ${fontFamily};`} {...rest}>
  <slot />
</Tag>
