---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../utils/cn';

const bodyVariants = cva('text-text-lighter', {
  variants: {
    size: {
      sm: 'text-sm leading-normal',              // 14px → 16.8px after scaling
      base: 'text-base leading-relaxed',         // 16px → 19.2px after scaling
      lg: 'text-base lg:text-xl leading-relaxed',  // Mobile/Tablet: 16px → 19.2px | Desktop: 24px → 28.8px (1.5x larger on desktop)
      xl: 'text-xl leading-relaxed',             // 24px → 28.8px after scaling
    },
  },
  defaultVariants: {
    size: 'base',
  },
});

type Props = VariantProps<typeof bodyVariants> & {
  as?: 'p' | 'span' | 'div' | 'li' | 'ul' | 'a';
  class?: string;
};

const { size, as: Tag = 'p', class: className, ...rest } = Astro.props;
---

<Tag class:list={[cn(bodyVariants({ size }), className)]} {...rest}>
  <slot />
</Tag>
