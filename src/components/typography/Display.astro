---
import { cva, type VariantProps } from 'class-variance-authority';

const displayVariants = cva('font-bold text-text text-balance tracking-tight', {
  variants: {
    level: {
      1: 'text-3xl lg:text-5xl',  // Mobile/Tablet: 40px → 48px | Desktop: 64px → 76.8px (1.6x larger on desktop)
      2: 'text-2xl lg:text-4xl',  // Mobile/Tablet: 32px → 38.4px | Desktop: 48px → 57.6px (1.5x larger on desktop)
    },
  },
  defaultVariants: {
    level: 1,
  },
});

type Props = VariantProps<typeof displayVariants> & {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'div';
  class?: string;
};

const { level, as: Tag = 'h1', class: className } = Astro.props;
---

<Tag class:list={[displayVariants({ level }), 'font-display', className]} style="font-family: var(--font-family-display);">
  <slot />
</Tag>
