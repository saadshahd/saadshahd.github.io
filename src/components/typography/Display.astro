---
import { cva, type VariantProps } from 'class-variance-authority';

const displayVariants = cva('font-bold text-accent', {
  variants: {
    level: {
      1: 'text-2xl md:text-3xl',  // 40px → 48px (hero headlines - larger than Heading)
      2: 'text-xl md:text-2xl',   // 32px → 40px (sub-hero headlines)
    },
  },
  defaultVariants: {
    level: 1,
  },
});

type Props = VariantProps<typeof displayVariants> & {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'div';
  class?: string;
};

const { level, as: Tag = 'h1', class: className } = Astro.props;
---

<Tag class:list={[displayVariants({ level }), className]}>
  <slot />
</Tag>
