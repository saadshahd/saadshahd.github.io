---
import Heading from './typography/Heading.astro';

type Props = {
  title: string;
  class?: string;
};

const { title, class: className } = Astro.props;
---


<div class={className}>
    <Heading level={3} as="h3" class="flex items-center gap-2 mb-4 text-text">
    <span>{title}</span>
  </Heading>
  <div class="text-text-lighter space-y-1 text-sm">
    <slot />
  </div>
</div>
