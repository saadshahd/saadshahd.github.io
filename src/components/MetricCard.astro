---
import { cva, type VariantProps } from 'class-variance-authority';
import { clsx } from 'clsx';

// CVA variant definitions - Neutral background + accent left border (Callout pattern)
const metricCard = cva(
  [
    'p-4',
    'rounded-lg',
    'bg-surface',
    'border-l-4',
  ],
  {
    variants: {
      variant: {
        skill: 'border-l-skill',       // Amber accent: Technical capabilities
        category: 'border-l-category', // Blue accent: System characteristics
        status: 'border-l-status',     // Emerald accent: Success/completion
      },
    },
    defaultVariants: {
      variant: 'skill',
    },
  }
);

const valueStyles = cva([
  'text-2xl',
  'font-bold',
  'mb-1',
]);

const labelStyles = cva([
  'text-xs',
  'font-semibold',
  'mb-1',
]);

const descriptionStyles = cva([
  'text-xs',
  'text-text-lighter',
]);

// Variant-specific text colors (muted for neutral background)
const textColorMap = {
  skill: 'text-text',         // Primary text (no color emphasis)
  category: 'text-text',      // Primary text
  status: 'text-text',        // Primary text
} as const;

type Props = VariantProps<typeof metricCard> & {
  value: string;        // "99%", "~20s", "10x"
  label: string;        // "Error prevention through linting"
  description: string;  // Context paragraph
  class?: string;
};

const {
  variant = 'skill',
  value,
  label,
  description,
  class: className,
} = Astro.props;

const textColor = textColorMap[variant];
---

<div class={clsx(metricCard({ variant }), className)}>
  <div class={clsx(valueStyles(), textColor)}>
    {value}
  </div>
  <div class={clsx(labelStyles(), textColor)}>
    {label}
  </div>
  <div class={descriptionStyles()}>
    {description}
  </div>
</div>
