---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../utils/cn';

const link = cva(
  'transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-md',
  {
    variants: {
      variant: {
        nav: 'text-sm text-text-lighter hover:text-text font-medium focus:ring-primary py-3 px-2',
        inline: 'text-secondary border-b border-secondary-light hover:text-secondary-dark hover:border-secondary-dark focus:ring-secondary',
        external: 'text-secondary hover:text-secondary-dark inline-flex items-center gap-1 focus:ring-secondary',
      },
      active: {
        true: 'text-text font-semibold',
      },
    },
    defaultVariants: {
      variant: 'inline',
    },
  }
);

type Props = VariantProps<typeof link> & {
  href: string;
  class?: string;
  external?: boolean;
  /**
   * Enable analytics tracking for this link (default: true for external links)
   */
  trackClick?: boolean;
};

const { variant, active, href, class: className, external = false, trackClick = external } = Astro.props;
const classes = cn(link({ variant, active }), className);

// External link attributes
const externalAttrs = external ? {
  target: '_blank',
  rel: 'noopener noreferrer'
} : {};

// Current page path for tracking source
const currentPath = Astro.url.pathname;
---

<a
  href={href}
  class={classes}
  {...externalAttrs}
  data-track-outbound={trackClick ? 'true' : undefined}
  data-track-destination={trackClick ? href : undefined}
  data-track-source={trackClick ? currentPath : undefined}
>
  <slot />
  {external && variant === 'external' && (
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  )}
</a>

{/* Client-side tracking script for outbound links */}
<script>
  import { trackOutboundLink } from '@/utils/analytics';

  // Track outbound link clicks
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const link = target.closest('[data-track-outbound="true"]') as HTMLAnchorElement;

    if (!link) return;

    const destination = link.getAttribute('data-track-destination') || link.href;
    const source = link.getAttribute('data-track-source') || window.location.pathname;
    const text = link.textContent?.trim() || '';

    if (destination && source) {
      trackOutboundLink(destination, source, text);
    }
  });
</script>
