---
import { cva, type VariantProps } from 'class-variance-authority';
import { clsx } from 'clsx';

const badge = cva(
  'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium',
  {
    variants: {
      variant: {
        skill: 'bg-amber-100 text-amber-800 border border-amber-200',
        category: 'bg-blue-100 text-blue-800 border border-blue-200',
        status: 'bg-cyan-100 text-cyan-800 border border-cyan-200',
      },
    },
    defaultVariants: {
      variant: 'skill',
    },
  }
);

type Props = VariantProps<typeof badge> & {
  class?: string;
};

const { variant, class: className } = Astro.props;
const classes = clsx(badge({ variant }), className);
---

<span class={classes}>
  <slot />
</span>
