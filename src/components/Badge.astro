---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../utils/cn';

const badge = cva(
  'inline-flex items-center rounded-full font-medium border',
  {
    variants: {
      variant: {
        skill: 'bg-badge-skill-bg text-badge-skill-text border-badge-skill-border',       // Warm amber/gold - technical skills (7.2:1 contrast)
        category: 'bg-badge-category-bg text-badge-category-text border-badge-category-border', // Sky blue - domains/categories (9.1:1 contrast)
        status: 'bg-badge-status-bg text-badge-status-text border-badge-status-border',   // Emerald green - status indicators (8.5:1 contrast)
      },
      size: {
        default: 'px-4 py-1 text-sm',
        xs: 'px-2 py-0.5 text-xs',
      },
    },
    defaultVariants: {
      variant: 'skill',
      size: 'default',
    },
  }
);

type Props = VariantProps<typeof badge> & {
  class?: string;
};

const { variant, size, class: className } = Astro.props;
const classes = cn(badge({ variant, size }), className);
---

<span class={classes}>
  <slot />
</span>
