---
/**
 * TextHighlight Component
 *
 * Scroll-triggered text highlighting for long-form case study content.
 * Uses Splitting.js for character-level animation + Motion One for Egyptian-themed reveals.
 *
 * Design Philosophy:
 * - Use SPARINGLY (2-3 highlights per section max) to avoid visual chaos
 * - Reserve for: architectural decisions, key technologies, breakthrough insights
 * - Avoid: entire sentences, common words, areas with many other visual elements
 *
 * @example
 * <TextHighlight variant="subtle-gold">XState</TextHighlight>
 * <TextHighlight variant="emphasis">architectural separation</TextHighlight>
 */

import { cva, type VariantProps } from 'class-variance-authority';

const variants = cva('text-highlight', {
  variants: {
    variant: {
      'subtle-gold': 'text-highlight--subtle-gold',
      'subtle-blue': 'text-highlight--subtle-blue',
      'emphasis': 'text-highlight--emphasis',
      'fade-in': 'text-highlight--fade-in' // No color change, just opacity/scale
    }
  },
  defaultVariants: {
    variant: 'fade-in'
  }
});

interface Props extends VariantProps<typeof variants> {
  /**
   * Semantic HTML element:
   * - 'mark' for meaningful emphasis (architectural terms, key insights)
   * - 'span' for purely decorative highlights
   */
  as?: 'mark' | 'span';
  class?: string;
}

const { variant, as: Tag = 'mark', class: className } = Astro.props;
---

<Tag class:list={[variants({ variant }), className]}>
  <slot />
</Tag>
