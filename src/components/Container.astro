---
import { cva, type VariantProps } from 'class-variance-authority';

const container = cva(
  'mx-auto px-4 md:px-6',
  {
    variants: {
      width: {
        narrow: 'max-w-4xl',    // Resume, About, Contact (prose-focused)
        default: 'max-w-6xl',   // Portfolio, Blog, Homepage (content-rich)
        wide: 'max-w-7xl',      // Future use for full-width layouts
      },
      spacing: {
        none: '',
        default: 'py-20',
        hero: 'md:min-h-[calc(100vh-5rem)] min-h-[calc(100vh-10rem)]',
      },
    },
    defaultVariants: {
      width: 'default',
      spacing: 'default',
    },
  }
);

type Props = VariantProps<typeof container> & {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'main';
};

const { width, spacing, class: className, as: Tag = 'div' } = Astro.props;
---

<Tag class:list={[container({ width, spacing }), className]}>
  <slot />
</Tag>
